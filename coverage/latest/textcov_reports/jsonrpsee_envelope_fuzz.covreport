_RNvNtNtNtCsc4HhLwrPL7g_11zebra_chain10parameters7network7subsidy21funding_stream_values:
  338|    248|pub fn funding_stream_values(
  339|    248|    height: Height,
  340|    248|    network: &Network,
  341|    248|    expected_block_subsidy: Amount<NonNegative>,
  342|    248|) -> Result<HashMap<FundingStreamReceiver, Amount<NonNegative>>, amount::Error> {
  343|    248|    let mut results = HashMap::new();
  344|       |
  345|    248|    if expected_block_subsidy.is_zero() {
  346|    100|        return Ok(results);
  347|    148|    }
  348|       |
  349|    148|    if NetworkUpgrade::current(network, height) >= NetworkUpgrade::Canopy {
  350|     96|        let funding_streams = network.funding_streams(height);
  351|     96|        if let Some(funding_streams) = funding_streams {
  352|    254|            for (&receiver, recipient) in funding_streams.recipients() {
  353|       |                // - Spec equation: `fs.value = floor(block_subsidy(height)*(fs.numerator/fs.denominator))`:
  354|       |                //   https://zips.z.cash/protocol/protocol.pdf#subsidies
  355|       |                // - In Rust, "integer division rounds towards zero":
  356|       |                //   https://doc.rust-lang.org/stable/reference/expressions/operator-expr.html#arithmetic-and-logical-binary-operators
  357|       |                //   This is the same as `floor()`, because these numbers are all positive.
  358|    254|                let amount_value = ((expected_block_subsidy * recipient.numerator())?
  359|      0|                    / FUNDING_STREAM_RECEIVER_DENOMINATOR)?;
  360|       |
  361|    254|                results.insert(receiver, amount_value);
  362|       |            }
  363|      4|        }
  364|     52|    }
  365|       |
  366|    148|    Ok(results)
  367|    248|}
