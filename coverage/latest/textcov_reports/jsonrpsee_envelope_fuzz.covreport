  455|  6.41k|fn build_envelope(data: &[u8]) -> Option<String> {
  456|  6.41k|    if data.len() < 2 {
  457|      1|        return None;
  458|  6.41k|    }
  459|  6.41k|    let method_idx = (data[1] as usize) % METHOD_NAMES.len();
  460|  6.41k|    let method = METHOD_NAMES[method_idx];
  461|  6.41k|    let params_kind = data[1] >> 6;
  462|  6.41k|    let payload = &data[2..];
  463|       |
  464|  6.41k|    let params_json = match params_kind {
  465|       |        0b00 => {
  466|       |            // Try to interpret as raw JSON; fall back to string literal.
  467|  4.91k|            match std::str::from_utf8(payload) {
  468|  4.90k|                Ok(s) if serde_json::from_str::<serde_json::Value>(s).is_ok() => s.to_string(),
  469|    974|                Ok(s) => format!("[{}]", serde_json::Value::String(s.to_string())),
  470|     15|                Err(_) => "[]".to_string(),
  471|       |            }
  472|       |        }
  473|       |        0b01 => {
  474|    320|            let s = String::from_utf8_lossy(payload).into_owned();
  475|    320|            format!("[{}]", serde_json::Value::String(s))
  476|       |        }
  477|       |        0b10 => {
  478|       |            // Numeric param: 8-byte BE → i64 then JSON number. Wider
  479|       |            // surface for handlers that take Option<i32> / Option<u32>
  480|       |            // (getblockhash, getnetworksolps, etc.).
  481|     35|            let mut buf = [0u8; 8];
  482|     61|            for (i, b) in payload.iter().take(8).enumerate() {
  483|     61|                buf[i] = *b;
  484|     61|            }
  485|     35|            let n = i64::from_be_bytes(buf);
  486|     35|            format!("[{}]", n)
  487|       |        }
  488|       |        _ => {
  489|       |            // ── Per-method schema-aware param template.
  490|       |            //
  491|       |            // Previously this slot was "raw bytes verbatim" which produces
  492|       |            // a syntactically-invalid params body 99% of the time and
  493|       |            // dies at envelope-level `serde_json::from_str::<Request>`
  494|       |            // instead of reaching the per-method `Params::parse::<T>`
  495|       |            // surface. By selecting a template based on the method name,
  496|       |            // we hand `Params::parse` a *type-shaped* body so the
  497|       |            // per-method decoder runs — that's the actual surface where
  498|       |            // per-method input-parsing panics live.
  499|       |            //
  500|       |            // The remaining fuzz bytes feed the template fields, so
