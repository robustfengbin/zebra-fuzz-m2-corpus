  422|    334|pub fn halving(height: Height, network: &Network) -> u32 {
  423|    334|    let slow_start_shift = network.slow_start_shift();
  424|    334|    let blossom_height = NetworkUpgrade::Blossom
  425|    334|        .activation_height(network)
  426|    334|        .expect("blossom activation height should be available");
  427|       |
  428|    334|    let halving_index = if height < slow_start_shift {
  429|    280|        0
  430|     54|    } else if height < blossom_height {
  431|      5|        let pre_blossom_height = height - slow_start_shift;
  432|      5|        pre_blossom_height / network.pre_blossom_halving_interval()
  433|       |    } else {
  434|     49|        let pre_blossom_height = blossom_height - slow_start_shift;
  435|     49|        let scaled_pre_blossom_height =
  436|     49|            pre_blossom_height * HeightDiff::from(BLOSSOM_POW_TARGET_SPACING_RATIO);
  437|       |
  438|     49|        let post_blossom_height = height - blossom_height;
  439|       |
  440|     49|        (scaled_pre_blossom_height + post_blossom_height) / network.post_blossom_halving_interval()
  441|       |    };
  442|       |
  443|    334|    halving_index
  444|    334|        .try_into()
  445|    334|        .expect("already checked for negatives")
