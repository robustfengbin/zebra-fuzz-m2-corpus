  341|    144|    expected_block_subsidy: Amount<NonNegative>,
  342|    144|) -> Result<HashMap<FundingStreamReceiver, Amount<NonNegative>>, amount::Error> {
  343|    144|    let mut results = HashMap::new();
  344|       |
  345|    144|    if expected_block_subsidy.is_zero() {
