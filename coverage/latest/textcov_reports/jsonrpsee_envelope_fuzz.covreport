  113|       |    #[cfg(any(
  114|       |        target_os = "aix",
  115|       |        target_os = "haiku",
  116|       |        target_os = "ios",
  117|       |        target_os = "macos",
  118|       |        target_os = "nto",
  119|       |        target_os = "tvos",
  120|       |        target_os = "visionos",
  121|       |        target_os = "watchos",
  122|       |        target_os = "espidf",
  123|       |        target_os = "vita",
  124|       |        target_os = "horizon"
  125|       |    ))]
  126|       |    {
