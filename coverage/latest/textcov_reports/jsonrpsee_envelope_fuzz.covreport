  140|    340|pub fn conventional_actions(transaction: &Transaction) -> u32 {
  141|    340|    let tx_in_total_size: usize = transaction
  142|    340|        .inputs()
  143|    340|        .iter()
  144|    340|        .map(|input| input.zcash_serialized_size())
  145|    340|        .sum();
  146|       |
  147|    340|    let tx_out_total_size: usize = transaction
  148|    340|        .outputs()
  149|    340|        .iter()
  150|    340|        .map(|output| output.zcash_serialized_size())
  151|    340|        .sum();
  152|       |
  153|    340|    let n_join_split = transaction.joinsplit_count();
  154|    340|    let n_spends_sapling = transaction.sapling_spends_per_anchor().count();
  155|    340|    let n_outputs_sapling = transaction.sapling_outputs().count();
  156|    340|    let n_actions_orchard = transaction.orchard_actions().count();
  157|       |
  158|    340|    let tx_in_logical_actions = div_ceil(tx_in_total_size, P2PKH_STANDARD_INPUT_SIZE);
  159|    340|    let tx_out_logical_actions = div_ceil(tx_out_total_size, P2PKH_STANDARD_OUTPUT_SIZE);
  160|       |
  161|    340|    let logical_actions = max(tx_in_logical_actions, tx_out_logical_actions)
  162|    340|        + 2 * n_join_split
  163|    340|        + max(n_spends_sapling, n_outputs_sapling)
  164|    340|        + n_actions_orchard;
  165|    340|    let logical_actions: u32 = logical_actions
  166|    340|        .try_into()
  167|    340|        .expect("transaction items are limited by serialized size limit");
  168|       |
  169|    340|    max(GRACE_ACTIONS, logical_actions)
  170|    340|}
