  356|    697|const fn compute_dec_exp(bin_exp: i32, regular: bool) -> i32 {
  357|    697|    debug_assert!(bin_exp >= -1334 && bin_exp <= 2620);
  358|       |    // log10_3_over_4_sig = -log10(3/4) * 2**log10_2_exp rounded to a power of 2
