  289|  8.22k|fn hash_bytes(bytes: &[u8]) -> u64 {
  290|  8.22k|    let len = bytes.len();
  291|  8.22k|    let mut s0 = SEED1;
  292|  8.22k|    let mut s1 = SEED2;
  293|       |
  294|  8.22k|    if len <= 16 {
  295|       |        // XOR the input into s0, s1.
  296|  5.56k|        if len >= 8 {
  297|  5.21k|            s0 ^= u64::from_le_bytes(bytes[0..8].try_into().unwrap());
  298|  5.21k|            s1 ^= u64::from_le_bytes(bytes[len - 8..].try_into().unwrap());
  299|  5.21k|        } else if len >= 4 {
  300|    338|            s0 ^= u32::from_le_bytes(bytes[0..4].try_into().unwrap()) as u64;
  301|    338|            s1 ^= u32::from_le_bytes(bytes[len - 4..].try_into().unwrap()) as u64;
  302|    338|        } else if len > 0 {
  303|      5|            let lo = bytes[0];
  304|      5|            let mid = bytes[len / 2];
  305|      5|            let hi = bytes[len - 1];
  306|      5|            s0 ^= lo as u64;
  307|      5|            s1 ^= ((hi as u64) << 8) | mid as u64;
  308|      5|        }
  309|       |    } else {
  310|       |        // Handle bulk (can partially overlap with suffix).
  311|  2.66k|        let mut bulk = &bytes[..(len - 1)];
  312|  5.58k|        while let Some((chunk, rest)) = bulk.split_first_chunk::<16>() {
  313|  2.92k|            let x = u64::from_le_bytes((&chunk[..8]).try_into().unwrap());
  314|  2.92k|            let y = u64::from_le_bytes((&chunk[8..]).try_into().unwrap());
  315|  2.92k|
  316|  2.92k|            // Replace s1 with a mix of s0, x, and y, and s0 with s1.
  317|  2.92k|            // This ensures the compiler can unroll this loop into two
  318|  2.92k|            // independent streams, one operating on s0, the other on s1.
  319|  2.92k|            //
  320|  2.92k|            // Since zeroes are a common input we prevent an immediate trivial
  321|  2.92k|            // collapse of the hash function by XOR'ing a constant with y.
  322|  2.92k|            let t = multiply_mix(s0 ^ x, PREVENT_TRIVIAL_ZERO_COLLAPSE ^ y);
  323|  2.92k|            s0 = s1;
  324|  2.92k|            s1 = t;
