  539|    248|pub fn founders_reward(net: &Network, height: Height) -> Amount<NonNegative> {
  540|       |    // The founders reward is 20% of the block subsidy before the first halving, and 0 afterwards.
  541|       |    //
  542|       |    // On custom testnets, the first halving can occur later than Canopy, which causes an
  543|       |    // inconsistency in the definition of the founders reward, which should occur only before
  544|       |    // Canopy, so we check if Canopy is active as well.
  545|    248|    if halving(height, net) < 1 && NetworkUpgrade::current(net, height) < NetworkUpgrade::Canopy {
  546|    148|        block_subsidy(height, net)
  547|    148|            .map(|subsidy| subsidy.div_exact(5))
  548|    148|            .expect("block subsidy must be valid for founders rewards")
  549|       |    } else {
  550|    100|        Amount::zero()
  551|       |    }
  552|    248|}
