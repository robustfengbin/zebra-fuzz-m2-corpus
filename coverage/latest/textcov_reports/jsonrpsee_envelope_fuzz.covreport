  291|       |
  292|    232|    let height_after_first_halving = height - network.height_for_first_halving();
  293|       |
  294|    232|    let address_period = (height_after_first_halving + network.post_blossom_halving_interval())
  295|    232|        / network.funding_stream_address_change_interval();
  296|       |
  297|    232|    address_period
  298|    232|        .try_into()
  299|    232|        .expect("all values are positive and smaller than the input height")
  300|    232|}
