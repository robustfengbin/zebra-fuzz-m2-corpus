  225|       |        // We need an additional check to ensure that the allocation doesn't
  226|       |        // exceed `isize::MAX` (https://github.com/rust-lang/rust/pull/95295).
  227|  2.94k|        if len > isize::MAX as usize - (ctrl_align - 1) {
  228|      0|            return None;
  229|  2.94k|        }
  230|       |
  231|  2.94k|        Some((
  232|  2.94k|            unsafe { Layout::from_size_align_unchecked(len, ctrl_align) },
  233|  2.94k|            ctrl_offset,
  234|  2.94k|        ))
  235|  2.94k|    }
