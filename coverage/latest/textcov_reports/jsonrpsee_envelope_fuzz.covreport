  466|       |            // Try to interpret as raw JSON; fall back to string literal.
  467|  4.73k|            match std::str::from_utf8(payload) {
  468|  4.72k|                Ok(s) if serde_json::from_str::<serde_json::Value>(s).is_ok() => s.to_string(),
