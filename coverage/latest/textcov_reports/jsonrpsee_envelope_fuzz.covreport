  451|    190|pub fn block_subsidy(height: Height, net: &Network) -> Result<Amount<NonNegative>, SubsidyError> {
  452|    190|    let Some(halving_div) = halving_divisor(height, net) else {
  453|      1|        return Ok(Amount::zero());
  454|       |    };
  455|       |
  456|    189|    let slow_start_interval = net.slow_start_interval();
  457|       |
  458|       |    // The `floor` fn used in the spec is implicit in Rust's division of primitive integer types.
  459|       |
  460|    189|    let amount = if height < slow_start_interval {
  461|    168|        let slow_start_rate = MAX_BLOCK_SUBSIDY / u64::from(slow_start_interval);
  462|       |
  463|    168|        if height < net.slow_start_shift() {
  464|    168|            slow_start_rate * u64::from(height)
  465|       |        } else {
  466|      0|            slow_start_rate * (u64::from(height) + 1)
  467|       |        }
  468|       |    } else {
  469|     21|        let base_subsidy = if NetworkUpgrade::current(net, height) < NetworkUpgrade::Blossom {
  470|      3|            MAX_BLOCK_SUBSIDY
  471|       |        } else {
  472|     18|            MAX_BLOCK_SUBSIDY / u64::from(BLOSSOM_POW_TARGET_SPACING_RATIO)
  473|       |        };
  474|       |
  475|     21|        base_subsidy / halving_div
  476|       |    };
  477|       |
  478|    189|    Ok(Amount::try_from(amount)?)
  479|    190|}
