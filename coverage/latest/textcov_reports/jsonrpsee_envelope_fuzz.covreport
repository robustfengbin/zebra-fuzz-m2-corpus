   72|    218|pub fn conventional_fee(transaction: &Transaction) -> Amount<NonNegative> {
   73|       |    // zcash_primitives checks for non-p2pkh inputs, but Zebra doesn't.
   74|       |    // Conventional fees are only used in the standard rules for mempool eviction
   75|       |    // and block production, so these implementations are compatible.
   76|       |    //
   77|       |    // <https://github.com/zcash/librustzcash/blob/main/zcash_primitives/src/transaction/fees/zip317.rs#L135>
   78|       |
   79|    218|    let marginal_fee: Amount<NonNegative> = MARGINAL_FEE.try_into().expect("fits in amount");
   80|       |
   81|       |    // marginal_fee * max(logical_actions, GRACE_ACTIONS)
   82|    218|    let conventional_fee = marginal_fee * conventional_actions(transaction).into();
   83|       |
   84|    218|    conventional_fee.expect("conventional fee is positive and limited by serialized size limit")
   85|    218|}
_RNvNtNtNtCsc4HhLwrPL7g_11zebra_chain11transaction7unmined6zip31720conventional_actions:
  140|    218|pub fn conventional_actions(transaction: &Transaction) -> u32 {
  141|    218|    let tx_in_total_size: usize = transaction
  142|    218|        .inputs()
  143|    218|        .iter()
  144|    218|        .map(|input| input.zcash_serialized_size())
  145|    218|        .sum();
  146|       |
  147|    218|    let tx_out_total_size: usize = transaction
  148|    218|        .outputs()
  149|    218|        .iter()
  150|    218|        .map(|output| output.zcash_serialized_size())
  151|    218|        .sum();
  152|       |
  153|    218|    let n_join_split = transaction.joinsplit_count();
  154|    218|    let n_spends_sapling = transaction.sapling_spends_per_anchor().count();
  155|    218|    let n_outputs_sapling = transaction.sapling_outputs().count();
  156|    218|    let n_actions_orchard = transaction.orchard_actions().count();
  157|       |
  158|    218|    let tx_in_logical_actions = div_ceil(tx_in_total_size, P2PKH_STANDARD_INPUT_SIZE);
  159|    218|    let tx_out_logical_actions = div_ceil(tx_out_total_size, P2PKH_STANDARD_OUTPUT_SIZE);
  160|       |
  161|    218|    let logical_actions = max(tx_in_logical_actions, tx_out_logical_actions)
  162|    218|        + 2 * n_join_split
  163|    218|        + max(n_spends_sapling, n_outputs_sapling)
  164|    218|        + n_actions_orchard;
  165|    218|    let logical_actions: u32 = logical_actions
  166|    218|        .try_into()
  167|    218|        .expect("transaction items are limited by serialized size limit");
  168|       |
  169|    218|    max(GRACE_ACTIONS, logical_actions)
  170|    218|}
