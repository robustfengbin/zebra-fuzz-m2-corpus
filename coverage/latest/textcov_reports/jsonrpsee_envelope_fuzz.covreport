  422|    424|pub fn halving(height: Height, network: &Network) -> u32 {
  423|    424|    let slow_start_shift = network.slow_start_shift();
  424|    424|    let blossom_height = NetworkUpgrade::Blossom
  425|    424|        .activation_height(network)
  426|    424|        .expect("blossom activation height should be available");
  427|       |
  428|    424|    let halving_index = if height < slow_start_shift {
  429|    315|        0
  430|    109|    } else if height < blossom_height {
  431|      5|        let pre_blossom_height = height - slow_start_shift;
  432|      5|        pre_blossom_height / network.pre_blossom_halving_interval()
  433|       |    } else {
  434|    104|        let pre_blossom_height = blossom_height - slow_start_shift;
  435|    104|        let scaled_pre_blossom_height =
  436|    104|            pre_blossom_height * HeightDiff::from(BLOSSOM_POW_TARGET_SPACING_RATIO);
  437|       |
  438|    104|        let post_blossom_height = height - blossom_height;
  439|       |
  440|    104|        (scaled_pre_blossom_height + post_blossom_height) / network.post_blossom_halving_interval()
  441|       |    };
  442|       |
  443|    424|    halving_index
  444|    424|        .try_into()
  445|    424|        .expect("already checked for negatives")
  446|    424|}
