  289|  9.53k|fn hash_bytes(bytes: &[u8]) -> u64 {
  290|  9.53k|    let len = bytes.len();
  291|  9.53k|    let mut s0 = SEED1;
  292|  9.53k|    let mut s1 = SEED2;
  293|       |
  294|  9.53k|    if len <= 16 {
  295|       |        // XOR the input into s0, s1.
  296|  6.57k|        if len >= 8 {
  297|  6.12k|            s0 ^= u64::from_le_bytes(bytes[0..8].try_into().unwrap());
  298|  6.12k|            s1 ^= u64::from_le_bytes(bytes[len - 8..].try_into().unwrap());
  299|  6.12k|        } else if len >= 4 {
  300|    451|            s0 ^= u32::from_le_bytes(bytes[0..4].try_into().unwrap()) as u64;
  301|    451|            s1 ^= u32::from_le_bytes(bytes[len - 4..].try_into().unwrap()) as u64;
  302|    451|        } else if len > 0 {
  303|      5|            let lo = bytes[0];
  304|      5|            let mid = bytes[len / 2];
  305|      5|            let hi = bytes[len - 1];
  306|      5|            s0 ^= lo as u64;
  307|      5|            s1 ^= ((hi as u64) << 8) | mid as u64;
  308|      5|        }
  309|       |    } else {
  310|       |        // Handle bulk (can partially overlap with suffix).
  311|  2.95k|        let mut bulk = &bytes[..(len - 1)];
  312|  6.24k|        while let Some((chunk, rest)) = bulk.split_first_chunk::<16>() {
  313|  3.28k|            let x = u64::from_le_bytes((&chunk[..8]).try_into().unwrap());
  314|  3.28k|            let y = u64::from_le_bytes((&chunk[8..]).try_into().unwrap());
  315|  3.28k|
  316|  3.28k|            // Replace s1 with a mix of s0, x, and y, and s0 with s1.
  317|  3.28k|            // This ensures the compiler can unroll this loop into two
  318|  3.28k|            // independent streams, one operating on s0, the other on s1.
  319|  3.28k|            //
  320|  3.28k|            // Since zeroes are a common input we prevent an immediate trivial
  321|  3.28k|            // collapse of the hash function by XOR'ing a constant with y.
  322|  3.28k|            let t = multiply_mix(s0 ^ x, PREVENT_TRIVIAL_ZERO_COLLAPSE ^ y);
  323|  3.28k|            s0 = s1;
  324|  3.28k|            s1 = t;
