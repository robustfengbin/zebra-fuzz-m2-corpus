  330|  2.66k|        s1 ^= u64::from_le_bytes(suffix[8..16].try_into().unwrap());
  331|       |    }
  332|       |
  333|  8.22k|    multiply_mix(s0, s1) ^ (len as u64)
  334|  8.22k|}
