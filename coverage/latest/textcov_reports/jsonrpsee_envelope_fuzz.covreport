   84|      1|fn pair<T>(flags: libc::c_int) -> io::Result<(T, T)>
   85|      1|where
   86|      1|    T: FromRawFd,
   87|       |{
   88|       |    #[cfg(not(any(
   89|       |        target_os = "aix",
   90|       |        target_os = "haiku",
   91|       |        target_os = "ios",
   92|       |        target_os = "macos",
   93|       |        target_os = "nto",
   94|       |        target_os = "tvos",
   95|       |        target_os = "visionos",
   96|       |        target_os = "watchos",
   97|       |        target_os = "espidf",
   98|       |        target_os = "vita",
   99|       |        target_os = "horizon",
  100|       |    )))]
  101|      1|    let flags = flags | libc::SOCK_NONBLOCK | libc::SOCK_CLOEXEC;
  102|       |
