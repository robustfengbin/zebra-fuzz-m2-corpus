  293|       |
  294|     42|    let address_period = (height_after_first_halving + network.post_blossom_halving_interval())
  295|     42|        / network.funding_stream_address_change_interval();
  296|       |
  297|     42|    address_period
  298|     42|        .try_into()
  299|     42|        .expect("all values are positive and smaller than the input height")
  300|     42|}
