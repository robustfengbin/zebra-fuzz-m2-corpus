  455|  8.21k|fn build_envelope(data: &[u8]) -> Option<String> {
  456|  8.21k|    if data.len() < 2 {
  457|      1|        return None;
  458|  8.20k|    }
  459|  8.20k|    let method_idx = (data[1] as usize) % METHOD_NAMES.len();
  460|  8.20k|    let method = METHOD_NAMES[method_idx];
  461|  8.20k|    let params_kind = data[1] >> 6;
  462|  8.20k|    let payload = &data[2..];
  463|       |
  464|  8.20k|    let params_json = match params_kind {
  465|       |        0b00 => {
  466|       |            // Try to interpret as raw JSON; fall back to string literal.
  467|  6.17k|            match std::str::from_utf8(payload) {
  468|  6.07k|                Ok(s) if serde_json::from_str::<serde_json::Value>(s).is_ok() => s.to_string(),
  469|  1.08k|                Ok(s) => format!("[{}]", serde_json::Value::String(s.to_string())),
  470|    100|                Err(_) => "[]".to_string(),
  471|       |            }
  472|       |        }
  473|       |        0b01 => {
  474|    453|            let s = String::from_utf8_lossy(payload).into_owned();
  475|    453|            format!("[{}]", serde_json::Value::String(s))
  476|       |        }
  477|       |        0b10 => {
  478|       |            // Numeric param: 8-byte BE → i64 then JSON number. Wider
  479|       |            // surface for handlers that take Option<i32> / Option<u32>
  480|       |            // (getblockhash, getnetworksolps, etc.).
  481|     85|            let mut buf = [0u8; 8];
  482|    396|            for (i, b) in payload.iter().take(8).enumerate() {
  483|    396|                buf[i] = *b;
  484|    396|            }
  485|     85|            let n = i64::from_be_bytes(buf);
  486|     85|            format!("[{}]", n)
  487|       |        }
  488|       |        _ => {
  489|       |            // ── Per-method schema-aware param template.
  490|       |            //
  491|       |            // Previously this slot was "raw bytes verbatim" which produces
  492|       |            // a syntactically-invalid params body 99% of the time and
  493|       |            // dies at envelope-level `serde_json::from_str::<Request>`
  494|       |            // instead of reaching the per-method `Params::parse::<T>`
  495|       |            // surface. By selecting a template based on the method name,
  496|       |            // we hand `Params::parse` a *type-shaped* body so the
  497|       |            // per-method decoder runs — that's the actual surface where
  498|       |            // per-method input-parsing panics live.
  499|       |            //
  500|       |            // The remaining fuzz bytes feed the template fields, so
  501|       |            // libFuzzer can mutate around the type shape (e.g. flip a
  502|       |            // bool, twiddle a number, lengthen a hex string) and reach
  503|       |            // both the success path and the per-field rejection paths.
  504|  1.50k|            build_method_param_template(method, payload)
  505|       |        }
  506|       |    };
  507|       |
  508|  8.20k|    Some(format!(
  509|  8.20k|        r#"{{"jsonrpc":"2.0","method":"{}","params":{},"id":1}}"#,
  510|  8.20k|        method, params_json
  511|  8.20k|    ))
