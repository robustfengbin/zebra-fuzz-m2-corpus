  422|    520|pub fn halving(height: Height, network: &Network) -> u32 {
  423|    520|    let slow_start_shift = network.slow_start_shift();
  424|    520|    let blossom_height = NetworkUpgrade::Blossom
  425|    520|        .activation_height(network)
  426|    520|        .expect("blossom activation height should be available");
  427|       |
  428|    520|    let halving_index = if height < slow_start_shift {
  429|    360|        0
  430|    160|    } else if height < blossom_height {
  431|      5|        let pre_blossom_height = height - slow_start_shift;
  432|      5|        pre_blossom_height / network.pre_blossom_halving_interval()
  433|       |    } else {
  434|    155|        let pre_blossom_height = blossom_height - slow_start_shift;
  435|    155|        let scaled_pre_blossom_height =
  436|    155|            pre_blossom_height * HeightDiff::from(BLOSSOM_POW_TARGET_SPACING_RATIO);
  437|       |
