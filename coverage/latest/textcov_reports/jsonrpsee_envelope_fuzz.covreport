 1537|  1.38k|                state,
 1538|  1.38k|                state | VALUE_SENT,
 1539|  1.38k|                Ordering::AcqRel,
 1540|  1.38k|                Ordering::Acquire,
 1541|  1.38k|            ) {
 1542|  1.38k|                Ok(_) => break,
 1543|      0|                Err(actual) => state = actual,
 1544|       |            }
 1545|       |        }
 1546|  1.38k|        State(state)
 1547|  1.38k|    }
