  470|     15|                Err(_) => "[]".to_string(),
  471|       |            }
  472|       |        }
  473|       |        0b01 => {
  474|    314|            let s = String::from_utf8_lossy(payload).into_owned();
  475|    314|            format!("[{}]", serde_json::Value::String(s))
  476|       |        }
  477|       |        0b10 => {
  478|       |            // Numeric param: 8-byte BE → i64 then JSON number. Wider
  479|       |            // surface for handlers that take Option<i32> / Option<u32>
  480|       |            // (getblockhash, getnetworksolps, etc.).
  481|     32|            let mut buf = [0u8; 8];
