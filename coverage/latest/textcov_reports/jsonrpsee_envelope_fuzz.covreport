  422|    345|pub fn halving(height: Height, network: &Network) -> u32 {
  423|    345|    let slow_start_shift = network.slow_start_shift();
  424|    345|    let blossom_height = NetworkUpgrade::Blossom
  425|    345|        .activation_height(network)
  426|    345|        .expect("blossom activation height should be available");
  427|       |
  428|    345|    let halving_index = if height < slow_start_shift {
  429|    280|        0
  430|     65|    } else if height < blossom_height {
  431|      5|        let pre_blossom_height = height - slow_start_shift;
  432|      5|        pre_blossom_height / network.pre_blossom_halving_interval()
  433|       |    } else {
  434|     60|        let pre_blossom_height = blossom_height - slow_start_shift;
  435|     60|        let scaled_pre_blossom_height =
  436|     60|            pre_blossom_height * HeightDiff::from(BLOSSOM_POW_TARGET_SPACING_RATIO);
  437|       |
  438|     60|        let post_blossom_height = height - blossom_height;
  439|       |
  440|     60|        (scaled_pre_blossom_height + post_blossom_height) / network.post_blossom_halving_interval()
  441|       |    };
  442|       |
  443|    345|    halving_index
  444|    345|        .try_into()
  445|    345|        .expect("already checked for negatives")
  446|    345|}
