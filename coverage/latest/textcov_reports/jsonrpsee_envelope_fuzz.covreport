  345|    150|    if expected_block_subsidy.is_zero() {
  346|     66|        return Ok(results);
  347|     84|    }
  348|       |
  349|     84|    if NetworkUpgrade::current(network, height) >= NetworkUpgrade::Canopy {
  350|     26|        let funding_streams = network.funding_streams(height);
  351|     26|        if let Some(funding_streams) = funding_streams {
  352|     60|            for (&receiver, recipient) in funding_streams.recipients() {
  353|       |                // - Spec equation: `fs.value = floor(block_subsidy(height)*(fs.numerator/fs.denominator))`:
  354|       |                //   https://zips.z.cash/protocol/protocol.pdf#subsidies
  355|       |                // - In Rust, "integer division rounds towards zero":
  356|       |                //   https://doc.rust-lang.org/stable/reference/expressions/operator-expr.html#arithmetic-and-logical-binary-operators
  357|       |                //   This is the same as `floor()`, because these numbers are all positive.
  358|     60|                let amount_value = ((expected_block_subsidy * recipient.numerator())?
  359|      0|                    / FUNDING_STREAM_RECEIVER_DENOMINATOR)?;
  360|       |
  361|     60|                results.insert(receiver, amount_value);
  362|       |            }
  363|      4|        }
  364|     58|    }
  365|       |
  366|     84|    Ok(results)
  367|    150|}
