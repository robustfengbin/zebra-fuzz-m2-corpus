 2937|     10|    async fn generate(&self, num_blocks: u32) -> Result<Vec<Hash>> {
 2938|       |        let mut rpc = self.clone();
 2939|       |        let network = self.network.clone();
 2940|       |
 2941|       |        if !network.disable_pow() {
 2942|       |            return Err(ErrorObject::borrowed(
 2943|       |                0,
