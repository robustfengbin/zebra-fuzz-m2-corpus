 2979|       |                    .map_error(server::error::LegacyCode::default())?,
 2980|       |            );
 2981|       |
 2982|       |            let r = rpc
 2983|       |                .submit_block(hex_proposal_block, None)
 2984|       |                .await
 2985|       |                .map_error(server::error::LegacyCode::default())?;
