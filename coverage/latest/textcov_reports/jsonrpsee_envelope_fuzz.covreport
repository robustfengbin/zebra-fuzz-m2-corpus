  309|       |                            // A channel is closed when all tx handles are
  310|       |                            // dropped. Dropping a tx handle releases memory,
  311|       |                            // which ensures that if dropping the tx handle is
  312|       |                            // visible, then all messages sent are also visible.
  313|       |                            debug_assert!(self.inner.semaphore.is_idle());
  314|       |                            coop.made_progress();
  315|       |                            return Ready(None);
  316|       |                        }
