  541|      2|    let output = match output {
  542|      0|        Ok(Poll::Pending) => return Poll::Pending,
  543|      2|        Ok(Poll::Ready(output)) => Ok(output),
  544|      0|        Err(panic) => Err(panic_to_error(&core.scheduler, core.task_id, panic)),
  545|       |    };
