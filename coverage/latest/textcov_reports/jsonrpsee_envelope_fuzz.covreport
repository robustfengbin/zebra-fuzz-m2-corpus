  226|       |        // exceed `isize::MAX` (https://github.com/rust-lang/rust/pull/95295).
  227|  1.60k|        if len > isize::MAX as usize - (ctrl_align - 1) {
  228|      0|            return None;
  229|  1.60k|        }
  230|       |
  231|  1.60k|        Some((
  232|  1.60k|            unsafe { Layout::from_size_align_unchecked(len, ctrl_align) },
  233|  1.60k|            ctrl_offset,
