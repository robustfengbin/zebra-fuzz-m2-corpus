  326|  3.28k|        }
  327|       |
  328|  2.95k|        let suffix = &bytes[len - 16..];
  329|  2.95k|        s0 ^= u64::from_le_bytes(suffix[0..8].try_into().unwrap());
  330|  2.95k|        s1 ^= u64::from_le_bytes(suffix[8..16].try_into().unwrap());
  331|       |    }
  332|       |
  333|  9.53k|    multiply_mix(s0, s1) ^ (len as u64)
  334|  9.53k|}
