  521|      2|fn poll_future<T: Future, S: Schedule>(core: &Core<T, S>, cx: Context<'_>) -> Poll<()> {
  522|       |    // Poll the future.
  523|      2|    let output = panic::catch_unwind(panic::AssertUnwindSafe(|| {
  524|       |        struct Guard<'a, T: Future, S: Schedule> {
  525|       |            core: &'a Core<T, S>,
