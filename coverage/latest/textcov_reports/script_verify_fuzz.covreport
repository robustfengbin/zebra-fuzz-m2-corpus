  357|   103k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   103k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   103k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   103k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
