  341|    275|    fn zcash_deserialize<R: std::io::Read>(mut reader: R) -> Result<Self, SerializationError> {
  342|       |        use SerializationError::Parse;
  343|       |
  344|    275|        let flag_byte = reader.read_u8()?;
  345|    274|        let size = match flag_byte {
  346|    274|            n @ 0x00..=0xfc => Ok(n as u64),
