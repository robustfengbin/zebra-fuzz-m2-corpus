 1459|      0|            let excess = 1 + (-year) / 400;
 1460|      0|            year += excess * 400;
 1461|      0|            ndays -= excess * 146_097;
 1462|    714|        }
 1463|    714|        let div_100 = year / 100;
 1464|    714|        ndays += ((year * 1461) >> 2) - div_100 + (div_100 >> 2);
 1465|    714|        ndays + self.ordinal() as i32
 1466|    714|    }
