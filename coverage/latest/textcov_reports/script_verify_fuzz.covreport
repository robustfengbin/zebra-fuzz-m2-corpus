  421|    441|            .unwrap_or_else(orchard::commitments::hash_bundle_txid_empty)
  422|    441|            .as_bytes(),
  423|       |    )
  424|    441|    .unwrap();
  425|       |
  426|       |    #[cfg(zcash_unstable = "zfuture")]
