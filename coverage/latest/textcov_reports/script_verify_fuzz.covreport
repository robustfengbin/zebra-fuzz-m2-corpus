  177|     25|pub(crate) fn hash_sapling_outputs<A>(shielded_outputs: &[OutputDescription<A>]) -> Blake2bHash {
  178|     25|    let mut h = hasher(ZCASH_SAPLING_OUTPUTS_HASH_PERSONALIZATION);
  179|     25|    if !shielded_outputs.is_empty() {
  180|     11|        let mut ch = hasher(ZCASH_SAPLING_OUTPUTS_COMPACT_HASH_PERSONALIZATION);
  181|     11|        let mut mh = hasher(ZCASH_SAPLING_OUTPUTS_MEMOS_HASH_PERSONALIZATION);
  182|     11|        let mut nh = hasher(ZCASH_SAPLING_OUTPUTS_NONCOMPACT_HASH_PERSONALIZATION);
  183|     22|        for s_out in shielded_outputs {
  184|     11|            ch.write_all(s_out.cmu().to_bytes().as_ref()).unwrap();
  185|     11|            ch.write_all(s_out.ephemeral_key().as_ref()).unwrap();
  186|     11|            ch.write_all(&s_out.enc_ciphertext()[..52]).unwrap();
  187|     11|
  188|     11|            mh.write_all(&s_out.enc_ciphertext()[52..564]).unwrap();
  189|     11|
  190|     11|            nh.write_all(&s_out.cv().to_bytes()).unwrap();
  191|     11|            nh.write_all(&s_out.enc_ciphertext()[564..]).unwrap();
  192|     11|            nh.write_all(&s_out.out_ciphertext()[..]).unwrap();
  193|     11|        }
  194|       |
  195|     11|        h.write_all(ch.finalize().as_bytes()).unwrap();
  196|     11|        h.write_all(mh.finalize().as_bytes()).unwrap();
  197|     11|        h.write_all(nh.finalize().as_bytes()).unwrap();
  198|     14|    }
  199|     25|    h.finalize()
  200|     25|}
