  357|   190k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   190k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   190k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   190k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   190k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   190k|        let k = r1.wrapping_mul(INV);
  364|   190k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   190k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   190k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   190k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   190k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   190k|        let k = r2.wrapping_mul(INV);
  371|   190k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   190k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   190k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   190k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   190k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   190k|        let k = r3.wrapping_mul(INV);
  378|   190k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   190k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   190k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   190k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
