  422|    187|            .as_bytes(),
  423|       |    )
  424|    187|    .unwrap();
  425|       |
  426|       |    #[cfg(zcash_unstable = "zfuture")]
  427|       |    if _txversion.has_tze() {
  428|       |        h.write_all(hash_tze_txid_data(tze_digests).as_bytes())
  429|       |            .unwrap();
  430|       |    }
  431|       |
  432|    187|    h.finalize()
