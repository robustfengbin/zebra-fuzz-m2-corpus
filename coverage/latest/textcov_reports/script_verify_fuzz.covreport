  702|     93|        let rb = sqr(ra, 7) * r1001;
  703|     93|        let rc = sqr(rb, 7) * r1101;
  704|     93|        let rd = sqr(rc, 4) * r11;
  705|     93|        let re = sqr(rd, 6) * r111;
  706|     93|        let rf = sqr(re, 3) * r111;
  707|     93|        let rg = sqr(rf, 10) * r1001;
  708|     93|        let rh = sqr(rg, 5) * r1001;
  709|     93|        let ri = sqr(rh, 4) * r1001;
  710|     93|        let rj = sqr(ri, 3) * r111;
  711|     93|        let rk = sqr(rj, 4) * r1001;
  712|     93|        let rl = sqr(rk, 5) * r11;
