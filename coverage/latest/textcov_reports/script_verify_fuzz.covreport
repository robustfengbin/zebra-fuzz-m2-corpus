  623|    830|        res[0..8].copy_from_slice(&tmp.0[0].to_le_bytes());
  624|    830|        res[8..16].copy_from_slice(&tmp.0[1].to_le_bytes());
  625|    830|        res[16..24].copy_from_slice(&tmp.0[2].to_le_bytes());
  626|    830|        res[24..32].copy_from_slice(&tmp.0[3].to_le_bytes());
