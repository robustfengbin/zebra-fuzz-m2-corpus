  378|    455|    pub const fn from_num_days_from_ce_opt(days: i32) -> Option<NaiveDate> {
  379|    455|        let days = try_opt!(days.checked_add(365)); // make December 31, 1 BCE equal to day 0
  380|    455|        let year_div_400 = days.div_euclid(146_097);
  381|    455|        let cycle = days.rem_euclid(146_097);
