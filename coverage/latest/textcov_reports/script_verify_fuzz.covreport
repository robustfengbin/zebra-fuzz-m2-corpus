  145|     25|pub(crate) fn hash_sapling_spends<A: sapling::bundle::Authorization>(
  146|     25|    shielded_spends: &[SpendDescription<A>],
  147|     25|) -> Blake2bHash {
  148|     25|    let mut h = hasher(ZCASH_SAPLING_SPENDS_HASH_PERSONALIZATION);
  149|     25|    if !shielded_spends.is_empty() {
  150|     15|        let mut ch = hasher(ZCASH_SAPLING_SPENDS_COMPACT_HASH_PERSONALIZATION);
  151|     15|        let mut nh = hasher(ZCASH_SAPLING_SPENDS_NONCOMPACT_HASH_PERSONALIZATION);
  152|     35|        for s_spend in shielded_spends {
  153|     20|            // we build the hash of nullifiers separately for compact blocks.
  154|     20|            ch.write_all(s_spend.nullifier().as_ref()).unwrap();
  155|     20|
  156|     20|            nh.write_all(&s_spend.cv().to_bytes()).unwrap();
  157|     20|            nh.write_all(&s_spend.anchor().to_repr()).unwrap();
  158|     20|            nh.write_all(&<[u8; 32]>::from(*s_spend.rk())).unwrap();
  159|     20|        }
  160|       |
  161|     15|        let compact_digest = ch.finalize();
  162|     15|        h.write_all(compact_digest.as_bytes()).unwrap();
  163|     15|        let noncompact_digest = nh.finalize();
  164|     15|        h.write_all(noncompact_digest.as_bytes()).unwrap();
  165|     10|    }
  166|     25|    h.finalize()
  167|     25|}
