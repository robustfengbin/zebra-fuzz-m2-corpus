  413|    187|    h.write_all(
  414|    187|        sapling_digest
  415|    187|            .unwrap_or_else(hash_sapling_txid_empty)
  416|    187|            .as_bytes(),
  417|       |    )
  418|    187|    .unwrap();
  419|    187|    h.write_all(
