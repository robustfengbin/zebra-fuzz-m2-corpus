  813|  2.98k|        let vv = self.v.square();
  814|  2.98k|        let zz2 = self.z.square().double();
  815|  2.98k|        let uv2 = (self.u + self.v).square();
  816|  2.98k|        let vv_plus_uu = vv + uu;
  817|  2.98k|        let vv_minus_uu = vv - uu;
  818|       |
