  342|   131k|    const fn montgomery_reduce(
  343|   131k|        r0: u64,
  344|   131k|        r1: u64,
  345|   131k|        r2: u64,
  346|   131k|        r3: u64,
  347|   131k|        r4: u64,
  348|   131k|        r5: u64,
  349|   131k|        r6: u64,
  350|   131k|        r7: u64,
  351|   131k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
