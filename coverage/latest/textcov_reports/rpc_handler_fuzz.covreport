  222|  8.60k|            size.checked_mul(buckets)?.checked_add(ctrl_align - 1)? & !(ctrl_align - 1);
  223|  8.60k|        let len = ctrl_offset.checked_add(buckets + Group::WIDTH)?;
  224|       |
  225|       |        // We need an additional check to ensure that the allocation doesn't
  226|       |        // exceed `isize::MAX` (https://github.com/rust-lang/rust/pull/95295).
  227|  8.60k|        if len > isize::MAX as usize - (ctrl_align - 1) {
  228|      0|            return None;
  229|  8.60k|        }
  230|       |
  231|  8.60k|        Some((
  232|  8.60k|            unsafe { Layout::from_size_align_unchecked(len, ctrl_align) },
  233|  8.60k|            ctrl_offset,
  234|  8.60k|        ))
  235|  8.60k|    }
