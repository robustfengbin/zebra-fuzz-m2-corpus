 2130|       |            let entry = Utxo {
 2131|       |                address,
 2132|       |                txid,
 2133|       |                output_index,
 2134|       |                script,
 2135|       |                satoshis,
 2136|       |                height,
 2137|       |            };
 2138|       |            response_utxos.push(entry);
 2139|       |
 2140|       |            last_output_location = output_location;
 2141|       |        }
