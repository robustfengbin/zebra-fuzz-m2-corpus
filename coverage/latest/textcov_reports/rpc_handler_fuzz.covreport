  547|    730|                inputs.zcash_serialize(&mut writer)?;
  548|       |
  549|       |                // Denoted as `tx_out_count` and `tx_out` in the spec.
  550|    730|                outputs.zcash_serialize(&mut writer)?;
  551|       |
