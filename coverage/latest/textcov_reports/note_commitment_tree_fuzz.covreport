  296|  26.2M|                let z = z * other.z;
  297|  26.2M|                let y1 = self.y * z;
  298|  26.2M|                let z = self.z.square();
  299|  26.2M|                let x2 = other.x * z;
  300|  26.2M|                let z = z * self.z;
  301|  26.2M|                let y2 = other.y * z;
  302|       |
  303|  26.2M|                let self_is_zero = self.is_identity();
  304|  26.2M|                let other_is_zero = other.is_identity();
  305|       |
  306|  26.2M|                (self_is_zero & other_is_zero) // Both point at infinity
  307|  26.2M|                            | ((!self_is_zero) & (!other_is_zero) & x1.ct_eq(&x2) & y1.ct_eq(&y2))
  308|       |                // Neither point at infinity, coordinates are the same
  309|  26.2M|            }
