  172|   107k|    let y = F::conditional_select(&y2, &y1, gx1_square);
  173|       |
  174|       |    // 9. If sgn0(u) != sgn0(y), set y = -y
  175|   107k|    let y = F::conditional_select(&(-y), &y, u.is_odd().ct_eq(&y.is_odd()));
  176|       |
  177|   107k|    I::new_jacobian(num_x * div, y * div3, div).unwrap()
  178|   107k|}
