  342|   562M|    const fn montgomery_reduce(
  343|   562M|        r0: u64,
  344|   562M|        r1: u64,
  345|   562M|        r2: u64,
  346|   562M|        r3: u64,
  347|   562M|        r4: u64,
  348|   562M|        r5: u64,
  349|   562M|        r6: u64,
  350|   562M|        r7: u64,
  351|   562M|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   562M|        let k = r0.wrapping_mul(INV);
  357|   562M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   562M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   562M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   562M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   562M|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   562M|        let k = r1.wrapping_mul(INV);
  364|   562M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   562M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   562M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   562M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   562M|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
