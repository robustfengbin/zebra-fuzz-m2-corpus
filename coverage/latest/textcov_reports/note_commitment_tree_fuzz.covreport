   43|   116k|fn merkle_crh_sprout(left: [u8; 32], right: [u8; 32]) -> [u8; 32] {
   44|   116k|    let mut other_block = [0u8; 64];
   45|   116k|    other_block[..32].copy_from_slice(&left[..]);
   46|   116k|    other_block[32..].copy_from_slice(&right[..]);
   47|       |
