   11|  53.6k|pub fn hash_to_field<F: FromUniformBytes<64>>(
   12|  53.6k|    curve_id: &str,
   13|  53.6k|    domain_prefix: &str,
   14|  53.6k|    message: &[u8],
   15|  53.6k|    buf: &mut [F; 2],
   16|  53.6k|) {
   17|  53.6k|    assert!(domain_prefix.len() < 256);
   18|  53.6k|    assert!((22 + curve_id.len() + domain_prefix.len()) < 256);
   19|       |
   20|       |    // Assume that the field size is 32 bytes and k is 256, where k is defined in
   21|       |    // <https://www.ietf.org/archive/id/draft-irtf-cfrg-hash-to-curve-10.html#name-security-considerations-3>.
   22|       |    const CHUNKLEN: usize = 64;
   23|       |    const_assert!(CHUNKLEN * 2 < 256);
