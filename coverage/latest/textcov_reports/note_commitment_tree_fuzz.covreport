   36|  53.6k|        .update(&[0; R_IN_BYTES])
   37|  53.6k|        .update(message)
   38|  53.6k|        .update(&[0, (CHUNKLEN * 2) as u8, 0])
   39|  53.6k|        .update(domain_prefix.as_bytes())
   40|  53.6k|        .update(b"-")
   41|  53.6k|        .update(curve_id.as_bytes())
   42|  53.6k|        .update(b"_XMD:BLAKE2b_SSWU_RO_")
