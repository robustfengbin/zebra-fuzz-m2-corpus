  554|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  555|       |        // Handbook of Applied Cryptography
  556|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  557|       |
  558|   398k|        let k = r0.wrapping_mul(INV);
  559|   398k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  560|   398k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  561|   398k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  562|   398k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  563|   398k|        let (r4, carry2) = adc(r4, 0, carry);
  564|       |
  565|   398k|        let k = r1.wrapping_mul(INV);
  566|   398k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  567|   398k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  568|   398k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  569|   398k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  570|   398k|        let (r5, carry2) = adc(r5, carry2, carry);
  571|       |
  572|   398k|        let k = r2.wrapping_mul(INV);
  573|   398k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  574|   398k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  575|   398k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  576|   398k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  577|   398k|        let (r6, carry2) = adc(r6, carry2, carry);
  578|       |
  579|   398k|        let k = r3.wrapping_mul(INV);
  580|   398k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  581|   398k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  582|   398k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  583|   398k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  584|   398k|        let (r7, _) = adc(r7, carry2, carry);
  585|       |
  586|       |        // Result may be within MODULUS of the correct value
  587|   398k|        (&Fr([r4, r5, r6, r7])).sub(&MODULUS)
  588|   398k|    }
