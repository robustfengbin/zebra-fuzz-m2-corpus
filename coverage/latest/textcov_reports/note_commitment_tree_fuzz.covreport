  600|  1.53k|        let (_, borrow) = sbb(tmp.0[0], MODULUS.0[0], 0);
  601|  1.53k|        let (_, borrow) = sbb(tmp.0[1], MODULUS.0[1], borrow);
  602|  1.53k|        let (_, borrow) = sbb(tmp.0[2], MODULUS.0[2], borrow);
