  506|  73.5M|    const fn montgomery_reduce(
  507|  73.5M|        r0: u64,
  508|  73.5M|        r1: u64,
  509|  73.5M|        r2: u64,
  510|  73.5M|        r3: u64,
  511|  73.5M|        r4: u64,
  512|  73.5M|        r5: u64,
  513|  73.5M|        r6: u64,
  514|  73.5M|        r7: u64,
  515|  73.5M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|  73.5M|        let k = r0.wrapping_mul(INV);
  521|  73.5M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|  73.5M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|  73.5M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|  73.5M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|  73.5M|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|  73.5M|        let k = r1.wrapping_mul(INV);
  528|  73.5M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|  73.5M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|  73.5M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|  73.5M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|  73.5M|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|  73.5M|        let k = r2.wrapping_mul(INV);
  535|  73.5M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|  73.5M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  73.5M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  73.5M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|  73.5M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|  73.5M|        let k = r3.wrapping_mul(INV);
  542|  73.5M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|  73.5M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|  73.5M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|  73.5M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|  73.5M|        let (r7, _) = adc(r7, carry2, carry);
