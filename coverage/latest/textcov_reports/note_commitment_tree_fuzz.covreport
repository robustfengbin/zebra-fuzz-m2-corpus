   44|  53.6k|        .finalize();
   45|       |
   46|  53.6k|    let b_1 = empty_hasher
   47|  53.6k|        .clone()
   48|  53.6k|        .update(b_0.as_array())
   49|  53.6k|        .update(&[1])
   50|  53.6k|        .update(domain_prefix.as_bytes())
   51|  53.6k|        .update(b"-")
   52|  53.6k|        .update(curve_id.as_bytes())
   53|  53.6k|        .update(b"_XMD:BLAKE2b_SSWU_RO_")
