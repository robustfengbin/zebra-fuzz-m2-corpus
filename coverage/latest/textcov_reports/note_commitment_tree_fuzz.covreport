  294|  11.1M|                let z = other.z.square();
  295|  11.1M|                let x1 = self.x * z;
  296|  11.1M|                let z = z * other.z;
  297|  11.1M|                let y1 = self.y * z;
  298|  11.1M|                let z = self.z.square();
  299|  11.1M|                let x2 = other.x * z;
  300|  11.1M|                let z = z * self.z;
  301|  11.1M|                let y2 = other.y * z;
  302|       |
  303|  11.1M|                let self_is_zero = self.is_identity();
  304|  11.1M|                let other_is_zero = other.is_identity();
  305|       |
  306|  11.1M|                (self_is_zero & other_is_zero) // Both point at infinity
  307|  11.1M|                            | ((!self_is_zero) & (!other_is_zero) & x1.ct_eq(&x2) & y1.ct_eq(&y2))
  308|       |                // Neither point at infinity, coordinates are the same
  309|  11.1M|            }
