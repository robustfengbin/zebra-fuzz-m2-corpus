  102|  53.6k|    let xo = num_x * div_y * zo;
  103|  53.6k|    let yo = num_y * div_x * zo.square();
  104|       |
  105|  53.6k|    C::new_jacobian(xo, yo, zo).unwrap()
  106|  53.6k|}

