   97|       |
   98|   126k|    let num_y = (((iso[6] * x + iso[7] * z2) * x + iso[8] * z4) * x + iso[9] * z6) * y;
   99|   126k|    let div_y = (((x + iso[10] * z2) * x + iso[11] * z4) * x + iso[12] * z6) * z3;
  100|       |
  101|   126k|    let zo = div_x * div_y;
  102|   126k|    let xo = num_x * div_y * zo;
  103|   126k|    let yo = num_y * div_x * zo.square();
  104|       |
  105|   126k|    C::new_jacobian(xo, yo, zo).unwrap()
  106|   126k|}

