   58|       |    // https://github.com/RustCrypto/hashes/blob/master/sha2/src/sha256.rs#L40
   59|  54.7k|    let mut derived_bytes = [0u8; 32];
   60|  54.7k|    BigEndian::write_u32_into(&state, &mut derived_bytes);
   61|       |
   62|  54.7k|    derived_bytes
   63|  54.7k|}
