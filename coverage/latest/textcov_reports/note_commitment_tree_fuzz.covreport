   62|  53.6k|        empty_hasher
   63|  53.6k|            .update(&[2])
   64|  53.6k|            .update(domain_prefix.as_bytes())
   65|  53.6k|            .update(b"-")
   66|  53.6k|            .update(curve_id.as_bytes())
   67|  53.6k|            .update(b"_XMD:BLAKE2b_SSWU_RO_")
   68|  53.6k|            .update(&[(22 + curve_id.len() + domain_prefix.len()) as u8])
   69|  53.6k|            .finalize()
