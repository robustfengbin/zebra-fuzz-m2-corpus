_RINvNtCs5xmS2putXSG_12pasta_curves11hashtocurve23map_to_curve_simple_swuNtNtNtB4_6fields2fp2FpNtNtB4_6curves2EpNtB1w_5IsoEpEB4_:
  109|   252k|pub fn map_to_curve_simple_swu<F: PrimeField, C: CurveExt<Base = F>, I: CurveExt<Base = F>>(
  110|   252k|    u: &F,
  111|   252k|    theta: F,
  112|   252k|    z: F,
  113|   252k|) -> I {
  114|       |    // 1. tv1 = inv0(Z^2 * u^4 + Z * u^2)
  115|       |    // 2. x1 = (-B / A) * (1 + tv1)
  116|       |    // 3. If tv1 == 0, set x1 = B / (Z * A)
  117|       |    // 4. gx1 = x1^3 + A * x1 + B
  118|       |    //
  119|       |    // We use the "Avoiding inversions" optimization in [WB2019, section 4.2]
  120|       |    // (not to be confused with section 4.3):
  121|       |    //
  122|       |    //   here       [WB2019]
  123|       |    //   -------    ---------------------------------
  124|       |    //   Z          ξ
  125|       |    //   u          t
  126|       |    //   Z * u^2    ξ * t^2 (called u, confusingly)
  127|       |    //   x1         X_0(t)
  128|       |    //   x2         X_1(t)
  129|       |    //   gx1        g(X_0(t))
  130|       |    //   gx2        g(X_1(t))
  131|       |    //
  132|       |    // Using the "here" names:
  133|       |    //    x1 = num_x1/div      = [B*(Z^2 * u^4 + Z * u^2 + 1)] / [-A*(Z^2 * u^4 + Z * u^2]
  134|       |    //   gx1 = num_gx1/div_gx1 = [num_x1^3 + A * num_x1 * div^2 + B * div^3] / div^3
  135|       |
  136|   252k|    let a = I::a();
  137|   252k|    let b = I::b();
  138|   252k|    let z_u2 = z * u.square();
  139|   252k|    let ta = z_u2.square() + z_u2;
  140|   252k|    let num_x1 = b * (ta + F::ONE);
  141|   252k|    let div = a * F::conditional_select(&-ta, &z, ta.is_zero());
  142|   252k|    let num2_x1 = num_x1.square();
  143|   252k|    let div2 = div.square();
  144|   252k|    let div3 = div2 * div;
  145|   252k|    let num_gx1 = (num2_x1 + a * div2) * num_x1 + b * div3;
  146|       |
  147|       |    // 5. x2 = Z * u^2 * x1
  148|   252k|    let num_x2 = z_u2 * num_x1; // same div
  149|       |
  150|       |    // 6. gx2 = x2^3 + A * x2 + B  [optimized out; see below]
  151|       |    // 7. If is_square(gx1), set x = x1 and y = sqrt(gx1)
  152|       |    // 8. Else set x = x2 and y = sqrt(gx2)
  153|   252k|    let (gx1_square, y1) = F::sqrt_ratio(&num_gx1, &div3);
  154|       |
  155|       |    // This magic also comes from a generalization of [WB2019, section 4.2].
  156|       |    //
  157|       |    // The Sarkar square root algorithm with input s gives us a square root of
  158|       |    // h * s for free when s is not square, where h is a fixed nonsquare.
  159|       |    // In our implementation, h = ROOT_OF_UNITY.
  160|       |    // We know that Z / h is a square since both Z and h are
  161|       |    // nonsquares. Precompute theta as a square root of Z / ROOT_OF_UNITY.
  162|       |    //
  163|       |    // We have gx2 = g(Z * u^2 * x1) = Z^3 * u^6 * gx1
  164|       |    //                               = (Z * u^3)^2 * (Z/h * h * gx1)
  165|       |    //                               = (Z * theta * u^3)^2 * (h * gx1)
  166|       |    //
  167|       |    // When gx1 is not square, y1 is a square root of h * gx1, and so Z * theta * u^3 * y1
  168|       |    // is a square root of gx2. Note that we don't actually need to compute gx2.
  169|       |
  170|   252k|    let y2 = theta * z_u2 * u * y1;
  171|   252k|    let num_x = F::conditional_select(&num_x2, &num_x1, gx1_square);
  172|   252k|    let y = F::conditional_select(&y2, &y1, gx1_square);
  173|       |
  174|       |    // 9. If sgn0(u) != sgn0(y), set y = -y
  175|   252k|    let y = F::conditional_select(&(-y), &y, u.is_odd().ct_eq(&y.is_odd()));
  176|       |
  177|   252k|    I::new_jacobian(num_x * div, y * div3, div).unwrap()
  178|   252k|}
_RINvNtCs5xmS2putXSG_12pasta_curves11hashtocurve7iso_mapNtNtNtB4_6fields2fp2FpNtNtB4_6curves2EpNtB1f_5IsoEpEB4_:
   81|   126k|pub fn iso_map<F: Field, C: CurveExt<Base = F>, I: CurveExt<Base = F>>(
   82|   126k|    p: &I,
   83|   126k|    iso: &[C::Base; 13],
   84|   126k|) -> C {
   85|       |    // The input and output are in Jacobian coordinates, using the method
   86|       |    // in "Avoiding inversions" [WB2019, section 4.3].
