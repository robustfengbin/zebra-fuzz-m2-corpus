  591|  1.53k|    fn from_repr(repr: Self::Repr) -> CtOption<Self> {
  592|  1.53k|        let mut tmp = Fp([0, 0, 0, 0]);
  593|       |
  594|  1.53k|        tmp.0[0] = u64::from_le_bytes(repr[0..8].try_into().unwrap());
  595|  1.53k|        tmp.0[1] = u64::from_le_bytes(repr[8..16].try_into().unwrap());
  596|  1.53k|        tmp.0[2] = u64::from_le_bytes(repr[16..24].try_into().unwrap());
  597|  1.53k|        tmp.0[3] = u64::from_le_bytes(repr[24..32].try_into().unwrap());
