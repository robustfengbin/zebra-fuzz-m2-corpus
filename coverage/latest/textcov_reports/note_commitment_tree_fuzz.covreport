  594|  4.50k|        tmp.0[0] = u64::from_le_bytes(repr[0..8].try_into().unwrap());
  595|  4.50k|        tmp.0[1] = u64::from_le_bytes(repr[8..16].try_into().unwrap());
  596|  4.50k|        tmp.0[2] = u64::from_le_bytes(repr[16..24].try_into().unwrap());
  597|  4.50k|        tmp.0[3] = u64::from_le_bytes(repr[24..32].try_into().unwrap());
  598|       |
  599|       |        // Try to subtract the modulus
  600|  4.50k|        let (_, borrow) = sbb(tmp.0[0], MODULUS.0[0], 0);
  601|  4.50k|        let (_, borrow) = sbb(tmp.0[1], MODULUS.0[1], borrow);
  602|  4.50k|        let (_, borrow) = sbb(tmp.0[2], MODULUS.0[2], borrow);
  603|  4.50k|        let (_, borrow) = sbb(tmp.0[3], MODULUS.0[3], borrow);
