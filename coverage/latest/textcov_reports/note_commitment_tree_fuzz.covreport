   30|   126k|        .hash_length(CHUNKLEN)
   31|   126k|        .personal(&personal)
   32|   126k|        .to_state();
   33|       |
   34|   126k|    let b_0 = empty_hasher
   35|   126k|        .clone()
   36|   126k|        .update(&[0; R_IN_BYTES])
   37|   126k|        .update(message)
   38|   126k|        .update(&[0, (CHUNKLEN * 2) as u8, 0])
   39|   126k|        .update(domain_prefix.as_bytes())
   40|   126k|        .update(b"-")
   41|   126k|        .update(curve_id.as_bytes())
   42|   126k|        .update(b"_XMD:BLAKE2b_SSWU_RO_")
   43|   126k|        .update(&[(22 + curve_id.len() + domain_prefix.len()) as u8])
   44|   126k|        .finalize();
   45|       |
   46|   126k|    let b_1 = empty_hasher
   47|   126k|        .clone()
   48|   126k|        .update(b_0.as_array())
   49|   126k|        .update(&[1])
   50|   126k|        .update(domain_prefix.as_bytes())
   51|   126k|        .update(b"-")
   52|   126k|        .update(curve_id.as_bytes())
   53|   126k|        .update(b"_XMD:BLAKE2b_SSWU_RO_")
   54|   126k|        .update(&[(22 + curve_id.len() + domain_prefix.len()) as u8])
   55|   126k|        .finalize();
   56|       |
   57|   126k|    let b_2 = {
   58|   126k|        let mut empty_hasher = empty_hasher;
   59|  8.09M|        for (l, r) in b_0.as_array().iter().zip(b_1.as_array().iter()) {
   60|  8.09M|            empty_hasher.update(&[*l ^ *r]);
   61|  8.09M|        }
   62|   126k|        empty_hasher
   63|   126k|            .update(&[2])
   64|   126k|            .update(domain_prefix.as_bytes())
   65|   126k|            .update(b"-")
   66|   126k|            .update(curve_id.as_bytes())
   67|   126k|            .update(b"_XMD:BLAKE2b_SSWU_RO_")
   68|   126k|            .update(&[(22 + curve_id.len() + domain_prefix.len()) as u8])
   69|   126k|            .finalize()
   70|       |    };
   71|       |
   72|   252k|    for (big, buf) in [b_1, b_2].iter().zip(buf.iter_mut()) {
   73|   252k|        let mut little = [0u8; CHUNKLEN];
   74|   252k|        little.copy_from_slice(big.as_array());
   75|   252k|        little.reverse();
   76|   252k|        *buf = F::from_uniform_bytes(&little);
   77|   252k|    }
