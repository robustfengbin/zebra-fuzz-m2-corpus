   49|       |    // https://github.com/RustCrypto/hashes/blob/master/sha2/src/consts.rs#L170
   50|   116k|    let mut state = [
   51|   116k|        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab,
   52|   116k|        0x5be0cd19,
   53|   116k|    ];
   54|       |
   55|   116k|    sha2::compress256(&mut state, &[other_block.into()]);
   56|       |
   57|       |    // Yes, SHA-256 does big endian here.
   58|       |    // https://github.com/RustCrypto/hashes/blob/master/sha2/src/sha256.rs#L40
   59|   116k|    let mut derived_bytes = [0u8; 32];
   60|   116k|    BigEndian::write_u32_into(&state, &mut derived_bytes);
   61|       |
   62|   116k|    derived_bytes
   63|   116k|}
