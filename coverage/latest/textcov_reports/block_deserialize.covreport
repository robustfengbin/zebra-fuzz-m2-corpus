  711|  1.35k|        let rk = sqr(rj, 4) * r1001;
  712|  1.35k|        let rl = sqr(rk, 5) * r11;
  713|  1.35k|        let rm = sqr(rl, 4) * r111;
  714|  1.35k|        let rn = sqr(rm, 4) * r11;
  715|  1.35k|        let ro = sqr(rn, 6) * r1001;
  716|  1.35k|        let rp = sqr(ro, 5) * r1101;
