  386|       |
  387|    256|        let mut q = (limbs[0] + 19) >> 51;
  388|    256|        q = (limbs[1] + q) >> 51;
  389|    256|        q = (limbs[2] + q) >> 51;
  390|    256|        q = (limbs[3] + q) >> 51;
  391|    256|        q = (limbs[4] + q) >> 51;
  392|       |
