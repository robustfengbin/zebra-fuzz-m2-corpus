  421|    334|        s[ 8] =  (limbs[1] >> 13)                    as u8;
  422|    334|        s[ 9] =  (limbs[1] >> 21)                    as u8;
  423|    334|        s[10] =  (limbs[1] >> 29)                    as u8;
  424|    334|        s[11] =  (limbs[1] >> 37)                    as u8;
