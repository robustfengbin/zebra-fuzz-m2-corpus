  125|    220|    fn zcash_serialize<W: io::Write>(&self, mut writer: W) -> Result<(), io::Error> {
  126|    220|        let output = self.0.clone();
  127|    220|        writer.write_all(&output.cv.0.to_bytes())?;
  128|    220|        writer.write_all(&output.cm_u.to_bytes())?;
  129|    220|        output.ephemeral_key.zcash_serialize(&mut writer)?;
  130|    220|        output.enc_ciphertext.zcash_serialize(&mut writer)?;
  131|    220|        output.out_ciphertext.zcash_serialize(&mut writer)?;
  132|    220|        output.zkproof.zcash_serialize(&mut writer)?;
  133|    220|        Ok(())
