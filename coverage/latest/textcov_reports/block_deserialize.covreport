  354|  6.09M|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  6.09M|        let r3 = (r3 << 1) | (r2 >> 63);
  356|  6.09M|        let r2 = (r2 << 1) | (r1 >> 63);
  357|  6.09M|        let r1 = r1 << 1;
