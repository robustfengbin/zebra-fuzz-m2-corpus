  353|  6.59M|        let r5 = (r5 << 1) | (r4 >> 63);
  354|  6.59M|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  6.59M|        let r3 = (r3 << 1) | (r2 >> 63);
  356|  6.59M|        let r2 = (r2 << 1) | (r1 >> 63);
  357|  6.59M|        let r1 = r1 << 1;
  358|       |
  359|  6.59M|        let (r0, carry) = mac(0, self.0[0], self.0[0], 0);
  360|  6.59M|        let (r1, carry) = adc(0, r1, carry);
  361|  6.59M|        let (r2, carry) = mac(r2, self.0[1], self.0[1], carry);
  362|  6.59M|        let (r3, carry) = adc(0, r3, carry);
  363|  6.59M|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  364|  6.59M|        let (r5, carry) = adc(0, r5, carry);
  365|  6.59M|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
  366|  6.59M|        let (r7, _) = adc(0, r7, carry);
  367|       |
  368|  6.59M|        Scalar::montgomery_reduce(r0, r1, r2, r3, r4, r5, r6, r7)
