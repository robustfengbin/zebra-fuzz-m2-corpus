  200|       |
  201|    215|            let (height, data) = if script_sig.as_slice() == GENESIS_COINBASE_SCRIPT_SIG {
  202|      1|                (Height::MIN, GENESIS_COINBASE_SCRIPT_SIG.to_vec())
  203|       |            } else {
  204|    214|                parse_coinbase_height(&script_sig)?
  205|       |            };
  206|       |
  207|       |            Ok(Input::Coinbase {
  208|    215|                height,
  209|    215|                data,
  210|    215|                sequence: reader.read_u32::<LittleEndian>()?,
  211|       |            })
  212|       |        } else {
  213|       |            Ok(Input::PrevOut {
  214|       |                outpoint: OutPoint {
  215|  8.64k|                    hash: transaction::Hash(hash),
  216|  8.64k|                    index: reader.read_u32::<LittleEndian>()?,
  217|       |                },
  218|  8.64k|                unlock_script: Script::zcash_deserialize(&mut reader)?,
