  506|  9.00M|    const fn montgomery_reduce(
  507|  9.00M|        r0: u64,
  508|  9.00M|        r1: u64,
  509|  9.00M|        r2: u64,
  510|  9.00M|        r3: u64,
  511|  9.00M|        r4: u64,
  512|  9.00M|        r5: u64,
  513|  9.00M|        r6: u64,
  514|  9.00M|        r7: u64,
  515|  9.00M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
