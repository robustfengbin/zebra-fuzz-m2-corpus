  292|  17.7k|        res[16..24].copy_from_slice(&tmp.0[2].to_le_bytes());
  293|  17.7k|        res[24..32].copy_from_slice(&tmp.0[3].to_le_bytes());
  294|       |
  295|  17.7k|        res
  296|  17.7k|    }
