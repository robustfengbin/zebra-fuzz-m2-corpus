  168|  10.1k|    fn zcash_deserialize<R: io::Read>(mut reader: R) -> Result<Self, SerializationError> {
  169|       |        // This inlines the OutPoint deserialization to peek at the hash value and detect whether we
  170|       |        // have a coinbase input.
  171|  10.1k|        let hash = reader.read_32_bytes()?;
  172|       |
  173|       |        // Coinbase inputs have a null prevout hash.
  174|  10.1k|        if hash == [0; 32] {
  175|       |            // Coinbase txs have the prevout index set to `u32::MAX`.
  176|    264|            if reader.read_u32::<LittleEndian>()? != 0xffff_ffff {
  177|      0|                return Err(SerializationError::Parse("Wrong index in coinbase"));
  178|    264|            }
  179|       |
  180|       |            // Read the coinbase script length and validate it against the consensus
  181|       |            // bound *before* allocating any script bytes. The generic `Vec<u8>`
  182|       |            // deserializer would otherwise allocate up to MAX_PROTOCOL_MESSAGE_LEN
  183|       |            // bytes for an attacker-controlled CompactSize length and only reject
  184|       |            // afterwards, letting a peer force multi-MiB transient allocations per
  185|       |            // bogus block.
  186|       |            //
  187|       |            // # Consensus
  188|       |            //
  189|       |            // > A coinbase transaction script MUST have length in {2 .. 100} bytes.
  190|       |            //
  191|       |            // <https://zips.z.cash/protocol/protocol.pdf#txnconsensus>
  192|    264|            let len: CompactSizeMessage = (&mut reader).zcash_deserialize_into()?;
  193|    264|            let len: usize = len.into();
  194|    264|            if len < MIN_COINBASE_SCRIPT_LEN {
  195|      0|                return Err(SerializationError::Parse("Coinbase script is too short"));
  196|    264|            } else if len > MAX_COINBASE_SCRIPT_LEN {
  197|      0|                return Err(SerializationError::Parse("Coinbase script is too long"));
  198|    264|            }
  199|    264|            let script_sig = zcash_deserialize_bytes_external_count(len, &mut reader)?;
  200|       |
  201|    264|            let (height, data) = if script_sig.as_slice() == GENESIS_COINBASE_SCRIPT_SIG {
  202|      1|                (Height::MIN, GENESIS_COINBASE_SCRIPT_SIG.to_vec())
  203|       |            } else {
  204|    263|                parse_coinbase_height(&script_sig)?
  205|       |            };
  206|       |
  207|       |            Ok(Input::Coinbase {
  208|    264|                height,
  209|    264|                data,
  210|    264|                sequence: reader.read_u32::<LittleEndian>()?,
  211|       |            })
  212|       |        } else {
  213|       |            Ok(Input::PrevOut {
  214|       |                outpoint: OutPoint {
  215|  9.84k|                    hash: transaction::Hash(hash),
  216|  9.84k|                    index: reader.read_u32::<LittleEndian>()?,
  217|       |                },
  218|  9.84k|                unlock_script: Script::zcash_deserialize(&mut reader)?,
  219|  9.84k|                sequence: reader.read_u32::<LittleEndian>()?,
  220|       |            })
