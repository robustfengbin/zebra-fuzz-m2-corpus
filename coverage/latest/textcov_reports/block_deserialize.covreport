  341|  8.25M|    pub const fn square(&self) -> Scalar {
  342|  8.25M|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  8.25M|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
  344|  8.25M|        let (r3, r4) = mac(0, self.0[0], self.0[3], carry);
  345|       |
  346|  8.25M|        let (r3, carry) = mac(r3, self.0[1], self.0[2], 0);
  347|  8.25M|        let (r4, r5) = mac(r4, self.0[1], self.0[3], carry);
  348|       |
  349|  8.25M|        let (r5, r6) = mac(r5, self.0[2], self.0[3], 0);
  350|       |
  351|  8.25M|        let r7 = r6 >> 63;
