  341|  6.59M|    pub const fn square(&self) -> Scalar {
  342|  6.59M|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  6.59M|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
  344|  6.59M|        let (r3, r4) = mac(0, self.0[0], self.0[3], carry);
  345|       |
  346|  6.59M|        let (r3, carry) = mac(r3, self.0[1], self.0[2], 0);
  347|  6.59M|        let (r4, r5) = mac(r4, self.0[1], self.0[3], carry);
  348|       |
  349|  6.59M|        let (r5, r6) = mac(r5, self.0[2], self.0[3], 0);
  350|       |
  351|  6.59M|        let r7 = r6 >> 63;
