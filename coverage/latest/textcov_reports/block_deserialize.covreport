  692|  1.08k|    fn pow_by_t_minus1_over2(&self) -> Self {
  693|  1.08k|        let sqr = |x: Fp, i: u32| (0..i).fold(x, |x, _| x.square());
  694|       |
  695|  1.08k|        let r10 = self.square();
  696|  1.08k|        let r11 = r10 * self;
