  301|       |        // limb sizes, it's OK to do a "weak reduction", where we
  302|       |        // compute the carry-outs in parallel.
  303|       |
  304|    258|        let c0 = limbs[0] >> 51;
  305|    258|        let c1 = limbs[1] >> 51;
  306|    258|        let c2 = limbs[2] >> 51;
  307|    258|        let c3 = limbs[3] >> 51;
  308|    258|        let c4 = limbs[4] >> 51;
  309|       |
  310|    258|        limbs[0] &= LOW_51_BIT_MASK;
  311|    258|        limbs[1] &= LOW_51_BIT_MASK;
  312|    258|        limbs[2] &= LOW_51_BIT_MASK;
  313|    258|        limbs[3] &= LOW_51_BIT_MASK;
  314|    258|        limbs[4] &= LOW_51_BIT_MASK;
