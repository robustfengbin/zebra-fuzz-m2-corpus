  138|    110|    fn zcash_deserialize<R: io::Read>(mut reader: R) -> Result<Self, SerializationError> {
  139|       |        // # Consensus
  140|       |        //
  141|       |        // > Elements of an Output description MUST be valid encodings of the types given above.
  142|       |        //
  143|       |        // https://zips.z.cash/protocol/protocol.pdf#outputdesc
  144|       |        //
  145|       |        // > LEOS2IP_{256}(cmu) MUST be less than 𝑞_J.
