  387|    280|        let mut q = (limbs[0] + 19) >> 51;
  388|    280|        q = (limbs[1] + q) >> 51;
  389|    280|        q = (limbs[2] + q) >> 51;
  390|    280|        q = (limbs[3] + q) >> 51;
  391|    280|        q = (limbs[4] + q) >> 51;
