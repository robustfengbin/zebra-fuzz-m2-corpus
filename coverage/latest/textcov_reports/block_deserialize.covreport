  692|  1.15k|    fn pow_by_t_minus1_over2(&self) -> Self {
  693|  1.15k|        let sqr = |x: Fp, i: u32| (0..i).fold(x, |x, _| x.square());
  694|       |
  695|  1.15k|        let r10 = self.square();
  696|  1.15k|        let r11 = r10 * self;
  697|  1.15k|        let r110 = r11.square();
  698|  1.15k|        let r111 = r110 * self;
