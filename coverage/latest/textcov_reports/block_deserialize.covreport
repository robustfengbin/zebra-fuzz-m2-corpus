  420|    264|        s[ 7] =  (limbs[1] >>  5)                    as u8;
  421|    264|        s[ 8] =  (limbs[1] >> 13)                    as u8;
  422|    264|        s[ 9] =  (limbs[1] >> 21)                    as u8;
  423|    264|        s[10] =  (limbs[1] >> 29)                    as u8;
  424|    264|        s[11] =  (limbs[1] >> 37)                    as u8;
  425|    264|        s[12] = ((limbs[1] >> 45) | (limbs[2] << 6)) as u8;
