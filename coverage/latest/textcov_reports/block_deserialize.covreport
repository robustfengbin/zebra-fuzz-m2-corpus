  414|    340|        s[ 1] =  (limbs[0] >>  8)                    as u8;
  415|    340|        s[ 2] =  (limbs[0] >> 16)                    as u8;
  416|    340|        s[ 3] =  (limbs[0] >> 24)                    as u8;
  417|    340|        s[ 4] =  (limbs[0] >> 32)                    as u8;
  418|    340|        s[ 5] =  (limbs[0] >> 40)                    as u8;
  419|    340|        s[ 6] = ((limbs[0] >> 48) | (limbs[1] << 3)) as u8;
  420|    340|        s[ 7] =  (limbs[1] >>  5)                    as u8;
  421|    340|        s[ 8] =  (limbs[1] >> 13)                    as u8;
  422|    340|        s[ 9] =  (limbs[1] >> 21)                    as u8;
  423|    340|        s[10] =  (limbs[1] >> 29)                    as u8;
  424|    340|        s[11] =  (limbs[1] >> 37)                    as u8;
  425|    340|        s[12] = ((limbs[1] >> 45) | (limbs[2] << 6)) as u8;
  426|    340|        s[13] =  (limbs[2] >>  2)                    as u8;
  427|    340|        s[14] =  (limbs[2] >> 10)                    as u8;
  428|    340|        s[15] =  (limbs[2] >> 18)                    as u8;
  429|    340|        s[16] =  (limbs[2] >> 26)                    as u8;
  430|    340|        s[17] =  (limbs[2] >> 34)                    as u8;
  431|    340|        s[18] =  (limbs[2] >> 42)                    as u8;
