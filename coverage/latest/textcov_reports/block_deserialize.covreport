  387|    266|        let mut q = (limbs[0] + 19) >> 51;
  388|    266|        q = (limbs[1] + q) >> 51;
  389|    266|        q = (limbs[2] + q) >> 51;
  390|    266|        q = (limbs[3] + q) >> 51;
  391|    266|        q = (limbs[4] + q) >> 51;
