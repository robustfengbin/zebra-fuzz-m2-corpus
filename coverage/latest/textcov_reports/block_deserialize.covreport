  220|    128|            ephemeral_key: x25519_dalek::PublicKey::from(reader.read_32_bytes()?),
  221|       |            // Type is `B^{[ℓ_{Seed}]}`, i.e. 32 bytes
  222|    128|            random_seed: RandomSeed::from(reader.read_32_bytes()?),
