   30|    103|pub(crate) fn hash_bundle_txid_data<A: Authorization, V: Copy + Into<i64>>(
   31|    103|    bundle: &Bundle<A, V>,
   32|    103|) -> Blake2bHash {
   33|    103|    let mut h = hasher(ZCASH_ORCHARD_HASH_PERSONALIZATION);
   34|    103|    let mut ch = hasher(ZCASH_ORCHARD_ACTIONS_COMPACT_HASH_PERSONALIZATION);
   35|    103|    let mut mh = hasher(ZCASH_ORCHARD_ACTIONS_MEMOS_HASH_PERSONALIZATION);
   36|    103|    let mut nh = hasher(ZCASH_ORCHARD_ACTIONS_NONCOMPACT_HASH_PERSONALIZATION);
   37|       |
   38|    206|    for action in bundle.actions().iter() {
   39|    206|        ch.update(&action.nullifier().to_bytes());
   40|    206|        ch.update(&action.cmx().to_bytes());
