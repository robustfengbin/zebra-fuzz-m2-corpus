  316|    252|        limbs[0] += c4 * 19;
  317|    252|        limbs[1] += c0;
  318|    252|        limbs[2] += c1;
  319|    252|        limbs[3] += c2;
  320|    252|        limbs[4] += c3;
  321|       |
  322|    252|        FieldElement51(limbs)
