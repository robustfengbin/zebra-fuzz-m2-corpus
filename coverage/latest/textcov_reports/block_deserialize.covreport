  702|  1.11k|        let rb = sqr(ra, 7) * r1001;
  703|  1.11k|        let rc = sqr(rb, 7) * r1101;
  704|  1.11k|        let rd = sqr(rc, 4) * r11;
  705|  1.11k|        let re = sqr(rd, 6) * r111;
  706|  1.11k|        let rf = sqr(re, 3) * r111;
  707|  1.11k|        let rg = sqr(rf, 10) * r1001;
  708|  1.11k|        let rh = sqr(rg, 5) * r1001;
  709|  1.11k|        let ri = sqr(rh, 4) * r1001;
  710|  1.11k|        let rj = sqr(ri, 3) * r111;
  711|  1.11k|        let rk = sqr(rj, 4) * r1001;
  712|  1.11k|        let rl = sqr(rk, 5) * r11;
  713|  1.11k|        let rm = sqr(rl, 4) * r111;
  714|  1.11k|        let rn = sqr(rm, 4) * r11;
  715|  1.11k|        let ro = sqr(rn, 6) * r1001;
  716|  1.11k|        let rp = sqr(ro, 5) * r1101;
  717|  1.11k|        let rq = sqr(rp, 4) * r11;
  718|  1.11k|        let rr = sqr(rq, 7) * r111;
  719|  1.11k|        let rs = sqr(rr, 3) * r11;
  720|  1.11k|        rs.square() // rt
  721|  1.11k|    }

