_RINvXs3_NtNtCsc4HhLwrPL7g_11zebra_chain6sprout9joinsplitINtB6_9JoinSplitNtNtNtNtBa_10primitives6proofs6bctv1411Bctv14ProofENtNtNtBa_13serialization15zcash_serialize14ZcashSerialize15zcash_serializeQQQQNtNtB21_7sha256d6WriterEBa_:
  143|    256|    fn zcash_serialize<W: io::Write>(&self, mut writer: W) -> Result<(), io::Error> {
  144|    256|        self.vpub_old.zcash_serialize(&mut writer)?;
  145|    256|        self.vpub_new.zcash_serialize(&mut writer)?;
  146|       |
  147|    256|        writer.write_32_bytes(&self.anchor.into())?;
  148|    256|        writer.write_32_bytes(&self.nullifiers[0].into())?;
  149|    256|        writer.write_32_bytes(&self.nullifiers[1].into())?;
  150|    256|        writer.write_32_bytes(&self.commitments[0].into())?;
  151|    256|        writer.write_32_bytes(&self.commitments[1].into())?;
  152|       |
  153|    256|        writer.write_all(&self.ephemeral_key.as_bytes()[..])?;
  154|       |        // The borrow is actually needed to avoid taking ownership
  155|       |        #[allow(clippy::needless_borrow)]
  156|    256|        writer.write_32_bytes(&(&self.random_seed).into())?;
  157|       |
  158|    256|        self.vmacs[0].zcash_serialize(&mut writer)?;
  159|    256|        self.vmacs[1].zcash_serialize(&mut writer)?;
  160|    256|        self.zkproof.zcash_serialize(&mut writer)?;
  161|       |
  162|    256|        self.enc_ciphertexts[0].zcash_serialize(&mut writer)?;
  163|    256|        self.enc_ciphertexts[1].zcash_serialize(&mut writer)?;
  164|       |
