  111|      0|                _ => Err(io::Error::new(
  112|      0|                    io::ErrorKind::InvalidData,
  113|      0|                    "Unknown transaction format",
  114|      0|                )),
  115|       |            }
  116|      0|        } else if version >= 1 {
  117|      0|            Ok(TxVersion::Sprout(version))
  118|       |        } else {
  119|      0|            Err(io::Error::new(
  120|      0|                io::ErrorKind::InvalidData,
  121|      0|                "Unknown transaction format",
  122|      0|            ))
  123|       |        }
  124|  2.12k|    }
