   29|  42.0k|            let tail_ptr = data.as_ptr().add(blocks_len);
   30|  42.0k|            (
   31|  42.0k|                slice::from_raw_parts(blocks_ptr, nb),
   32|  42.0k|                slice::from_raw_parts(tail_ptr, tail_len),
