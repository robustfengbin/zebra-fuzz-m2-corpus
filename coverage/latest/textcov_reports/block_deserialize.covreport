  387|    264|        let mut q = (limbs[0] + 19) >> 51;
  388|    264|        q = (limbs[1] + q) >> 51;
  389|    264|        q = (limbs[2] + q) >> 51;
  390|    264|        q = (limbs[3] + q) >> 51;
  391|    264|        q = (limbs[4] + q) >> 51;
