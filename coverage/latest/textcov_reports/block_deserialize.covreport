  386|       |
  387|    290|        let mut q = (limbs[0] + 19) >> 51;
  388|    290|        q = (limbs[1] + q) >> 51;
  389|    290|        q = (limbs[2] + q) >> 51;
  390|    290|        q = (limbs[3] + q) >> 51;
  391|    290|        q = (limbs[4] + q) >> 51;
  392|       |
