  341|    494|    fn zcash_deserialize<R: std::io::Read>(mut reader: R) -> Result<Self, SerializationError> {
  342|       |        use SerializationError::Parse;
  343|       |
  344|    494|        let flag_byte = reader.read_u8()?;
  345|    494|        let size = match flag_byte {
  346|    494|            n @ 0x00..=0xfc => Ok(n as u64),
  347|      0|            0xfd => match reader.read_u16::<LittleEndian>()? {
  348|      0|                n @ 0x00fd..=u16::MAX => Ok(n as u64),
  349|      0|                _ => Err(Parse("non-canonical CompactSize")),
  350|       |            },
  351|      0|            0xfe => match reader.read_u32::<LittleEndian>()? {
  352|      0|                n @ 0x0001_0000..=u32::MAX => Ok(n as u64),
  353|      0|                _ => Err(Parse("non-canonical CompactSize")),
  354|       |            },
