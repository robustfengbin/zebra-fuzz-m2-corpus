  289|  18.2k|        let mut res = [0; 32];
  290|  18.2k|        res[0..8].copy_from_slice(&tmp.0[0].to_le_bytes());
  291|  18.2k|        res[8..16].copy_from_slice(&tmp.0[1].to_le_bytes());
  292|  18.2k|        res[16..24].copy_from_slice(&tmp.0[2].to_le_bytes());
  293|  18.2k|        res[24..32].copy_from_slice(&tmp.0[3].to_le_bytes());
  294|       |
  295|  18.2k|        res
  296|  18.2k|    }
