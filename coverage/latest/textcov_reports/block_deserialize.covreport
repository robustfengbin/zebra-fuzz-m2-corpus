   30|    101|pub(crate) fn hash_bundle_txid_data<A: Authorization, V: Copy + Into<i64>>(
   31|    101|    bundle: &Bundle<A, V>,
   32|    101|) -> Blake2bHash {
   33|    101|    let mut h = hasher(ZCASH_ORCHARD_HASH_PERSONALIZATION);
   34|    101|    let mut ch = hasher(ZCASH_ORCHARD_ACTIONS_COMPACT_HASH_PERSONALIZATION);
   35|    101|    let mut mh = hasher(ZCASH_ORCHARD_ACTIONS_MEMOS_HASH_PERSONALIZATION);
   36|    101|    let mut nh = hasher(ZCASH_ORCHARD_ACTIONS_NONCOMPACT_HASH_PERSONALIZATION);
