  583|  7.29M|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  584|  7.29M|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
  585|  7.29M|        let (d2, borrow) = sbb(self.0[2], rhs.0[2], borrow);
  586|  7.29M|        let (d3, borrow) = sbb(self.0[3], rhs.0[3], borrow);
