  145|    430|pub(crate) fn hash_sapling_spends<A: sapling::bundle::Authorization>(
  146|    430|    shielded_spends: &[SpendDescription<A>],
  147|    430|) -> Blake2bHash {
  148|    430|    let mut h = hasher(ZCASH_SAPLING_SPENDS_HASH_PERSONALIZATION);
