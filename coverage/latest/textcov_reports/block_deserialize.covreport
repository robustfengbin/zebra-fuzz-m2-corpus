  323|   319k|        let r4 = (r4 << 1) | (r3 >> 63);
  324|   319k|        let r3 = (r3 << 1) | (r2 >> 63);
  325|   319k|        let r2 = (r2 << 1) | (r1 >> 63);
  326|   319k|        let r1 = r1 << 1;
