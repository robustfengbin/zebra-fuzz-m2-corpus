  386|       |
  387|    286|        let mut q = (limbs[0] + 19) >> 51;
  388|    286|        q = (limbs[1] + q) >> 51;
  389|    286|        q = (limbs[2] + q) >> 51;
  390|    286|        q = (limbs[3] + q) >> 51;
  391|    286|        q = (limbs[4] + q) >> 51;
  392|       |
