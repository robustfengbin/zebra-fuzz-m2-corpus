   52|    103|    h.update(ch.finalize().as_bytes());
   53|    103|    h.update(mh.finalize().as_bytes());
   54|    103|    h.update(nh.finalize().as_bytes());
   55|    103|    h.update(&[bundle.flags().to_byte()]);
   56|    103|    h.update(&(*bundle.value_balance()).into().to_le_bytes());
   57|    103|    h.update(&bundle.anchor().to_bytes());
   58|    103|    h.finalize()
   59|    103|}
