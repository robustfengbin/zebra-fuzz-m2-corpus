  343|       |            | ((input[3] as u64) << 24)
  344|       |            | ((input[4] as u64) << 32)
  345|       |            | ((input[5] as u64) << 40)
  346|       |            | ((input[6] as u64) << 48)
  347|       |            | ((input[7] as u64) << 56)
