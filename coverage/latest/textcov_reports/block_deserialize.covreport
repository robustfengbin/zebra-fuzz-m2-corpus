  416|    272|        s[ 3] =  (limbs[0] >> 24)                    as u8;
  417|    272|        s[ 4] =  (limbs[0] >> 32)                    as u8;
  418|    272|        s[ 5] =  (limbs[0] >> 40)                    as u8;
  419|    272|        s[ 6] = ((limbs[0] >> 48) | (limbs[1] << 3)) as u8;
  420|    272|        s[ 7] =  (limbs[1] >>  5)                    as u8;
  421|    272|        s[ 8] =  (limbs[1] >> 13)                    as u8;
  422|    272|        s[ 9] =  (limbs[1] >> 21)                    as u8;
  423|    272|        s[10] =  (limbs[1] >> 29)                    as u8;
  424|    272|        s[11] =  (limbs[1] >> 37)                    as u8;
  425|    272|        s[12] = ((limbs[1] >> 45) | (limbs[2] << 6)) as u8;
  426|    272|        s[13] =  (limbs[2] >>  2)                    as u8;
  427|    272|        s[14] =  (limbs[2] >> 10)                    as u8;
  428|    272|        s[15] =  (limbs[2] >> 18)                    as u8;
  429|    272|        s[16] =  (limbs[2] >> 26)                    as u8;
