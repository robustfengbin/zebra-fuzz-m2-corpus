_RINvNtCs9QlSKl3ZH92_2ff7helpers19sqrt_tonelli_shanksNtNtCsg5EGzpCjk9o_9bls12_3816scalar6ScalarRAyj4_EBS_:
   18|  5.64k|pub fn sqrt_tonelli_shanks<F: PrimeField, S: AsRef<[u64]>>(f: &F, tm1d2: S) -> CtOption<F> {
   19|       |    // This is a constant-time version of https://eprint.iacr.org/2012/685.pdf (page 12,
   20|       |    // algorithm 5). Steps 2-5 of the algorithm are omitted because they are only needed
   21|       |    // to detect non-square input; it is more efficient to do that by checking at the end
   22|       |    // whether the square of the result is the input.
   23|       |
   24|       |    // w = self^((t - 1) // 2)
   25|  5.64k|    let w = f.pow_vartime(tm1d2);
   26|       |
   27|  5.64k|    let mut v = F::S;
   28|  5.64k|    let mut x = w * f;
   29|  5.64k|    let mut b = x * w;
   30|       |
