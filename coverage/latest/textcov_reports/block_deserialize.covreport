  707|  1.00k|        let rg = sqr(rf, 10) * r1001;
  708|  1.00k|        let rh = sqr(rg, 5) * r1001;
  709|  1.00k|        let ri = sqr(rh, 4) * r1001;
  710|  1.00k|        let rj = sqr(ri, 3) * r111;
  711|  1.00k|        let rk = sqr(rj, 4) * r1001;
  712|  1.00k|        let rl = sqr(rk, 5) * r11;
  713|  1.00k|        let rm = sqr(rl, 4) * r111;
  714|  1.00k|        let rn = sqr(rm, 4) * r11;
  715|  1.00k|        let ro = sqr(rn, 6) * r1001;
  716|  1.00k|        let rp = sqr(ro, 5) * r1101;
  717|  1.00k|        let rq = sqr(rp, 4) * r11;
