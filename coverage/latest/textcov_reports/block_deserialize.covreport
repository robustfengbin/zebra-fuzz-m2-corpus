  104|      0|                (V3_TX_VERSION, V3_VERSION_GROUP_ID) => Ok(TxVersion::V3),
  105|      0|                (V4_TX_VERSION, V4_VERSION_GROUP_ID) => Ok(TxVersion::V4),
  106|  2.12k|                (V5_TX_VERSION, V5_VERSION_GROUP_ID) => Ok(TxVersion::V5),
