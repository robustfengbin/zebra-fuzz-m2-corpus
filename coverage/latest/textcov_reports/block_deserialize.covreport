  302|       |        // compute the carry-outs in parallel.
  303|       |
  304|    248|        let c0 = limbs[0] >> 51;
  305|    248|        let c1 = limbs[1] >> 51;
  306|    248|        let c2 = limbs[2] >> 51;
  307|    248|        let c3 = limbs[3] >> 51;
  308|    248|        let c4 = limbs[4] >> 51;
  309|       |
  310|    248|        limbs[0] &= LOW_51_BIT_MASK;
  311|    248|        limbs[1] &= LOW_51_BIT_MASK;
  312|    248|        limbs[2] &= LOW_51_BIT_MASK;
  313|    248|        limbs[3] &= LOW_51_BIT_MASK;
  314|    248|        limbs[4] &= LOW_51_BIT_MASK;
