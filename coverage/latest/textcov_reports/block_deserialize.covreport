  264|       |        // Try to subtract the modulus
  265|  10.2k|        let (_, borrow) = sbb(tmp.0[0], MODULUS.0[0], 0);
  266|  10.2k|        let (_, borrow) = sbb(tmp.0[1], MODULUS.0[1], borrow);
  267|  10.2k|        let (_, borrow) = sbb(tmp.0[2], MODULUS.0[2], borrow);
  268|  10.2k|        let (_, borrow) = sbb(tmp.0[3], MODULUS.0[3], borrow);
