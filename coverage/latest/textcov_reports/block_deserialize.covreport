   52|    120|    h.update(ch.finalize().as_bytes());
   53|    120|    h.update(mh.finalize().as_bytes());
   54|    120|    h.update(nh.finalize().as_bytes());
   55|    120|    h.update(&[bundle.flags().to_byte()]);
   56|    120|    h.update(&(*bundle.value_balance()).into().to_le_bytes());
