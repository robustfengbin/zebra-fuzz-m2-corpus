  349|       |
  350|    340|        let low_51_bit_mask = (1u64 << 51) - 1;
  351|    340|        FieldElement51(
  352|    340|        // load bits [  0, 64), no shift
  353|    340|        [  load8(&bytes[ 0..])        & low_51_bit_mask
  354|    340|        // load bits [ 48,112), shift to [ 51,112)
  355|    340|        , (load8(&bytes[ 6..]) >>  3) & low_51_bit_mask
  356|    340|        // load bits [ 96,160), shift to [102,160)
  357|    340|        , (load8(&bytes[12..]) >>  6) & low_51_bit_mask
  358|    340|        // load bits [152,216), shift to [153,216)
  359|    340|        , (load8(&bytes[19..]) >>  1) & low_51_bit_mask
