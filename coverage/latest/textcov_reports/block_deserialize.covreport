  583|  6.53M|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  584|  6.53M|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
  585|  6.53M|        let (d2, borrow) = sbb(self.0[2], rhs.0[2], borrow);
  586|  6.53M|        let (d3, borrow) = sbb(self.0[3], rhs.0[3], borrow);
  587|       |
  588|       |        // If underflow occurred on the final limb, borrow = 0xfff...fff, otherwise
  589|       |        // borrow = 0x000...000. Thus, we use it as a mask to conditionally add the modulus.
  590|  6.53M|        let (d0, carry) = adc(d0, MODULUS.0[0] & borrow, 0);
  591|  6.53M|        let (d1, carry) = adc(d1, MODULUS.0[1] & borrow, carry);
  592|  6.53M|        let (d2, carry) = adc(d2, MODULUS.0[2] & borrow, carry);
  593|  6.53M|        let (d3, _) = adc(d3, MODULUS.0[3] & borrow, carry);
  594|       |
  595|  6.53M|        Scalar([d0, d1, d2, d3])
  596|  6.53M|    }
