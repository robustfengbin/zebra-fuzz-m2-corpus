  386|       |
  387|    272|        let mut q = (limbs[0] + 19) >> 51;
  388|    272|        q = (limbs[1] + q) >> 51;
  389|    272|        q = (limbs[2] + q) >> 51;
  390|    272|        q = (limbs[3] + q) >> 51;
  391|    272|        q = (limbs[4] + q) >> 51;
