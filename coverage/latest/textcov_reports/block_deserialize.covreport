  702|  1.15k|        let rb = sqr(ra, 7) * r1001;
  703|  1.15k|        let rc = sqr(rb, 7) * r1101;
  704|  1.15k|        let rd = sqr(rc, 4) * r11;
  705|  1.15k|        let re = sqr(rd, 6) * r111;
  706|  1.15k|        let rf = sqr(re, 3) * r111;
  707|  1.15k|        let rg = sqr(rf, 10) * r1001;
  708|  1.15k|        let rh = sqr(rg, 5) * r1001;
  709|  1.15k|        let ri = sqr(rh, 4) * r1001;
  710|  1.15k|        let rj = sqr(ri, 3) * r111;
  711|  1.15k|        let rk = sqr(rj, 4) * r1001;
  712|  1.15k|        let rl = sqr(rk, 5) * r11;
  713|  1.15k|        let rm = sqr(rl, 4) * r111;
  714|  1.15k|        let rn = sqr(rm, 4) * r11;
  715|  1.15k|        let ro = sqr(rn, 6) * r1001;
  716|  1.15k|        let rp = sqr(ro, 5) * r1101;
  717|  1.15k|        let rq = sqr(rp, 4) * r11;
  718|  1.15k|        let rr = sqr(rq, 7) * r111;
  719|  1.15k|        let rs = sqr(rr, 3) * r11;
  720|  1.15k|        rs.square() // rt
  721|  1.15k|    }

