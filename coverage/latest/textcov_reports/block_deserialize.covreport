  162|    250|        h.write_all(compact_digest.as_bytes()).unwrap();
  163|    250|        let noncompact_digest = nh.finalize();
  164|    250|        h.write_all(noncompact_digest.as_bytes()).unwrap();
  165|    180|    }
  166|    430|    h.finalize()
  167|    430|}
