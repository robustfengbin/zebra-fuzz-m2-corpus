   53|    101|    h.update(mh.finalize().as_bytes());
   54|    101|    h.update(nh.finalize().as_bytes());
   55|    101|    h.update(&[bundle.flags().to_byte()]);
   56|    101|    h.update(&(*bundle.value_balance()).into().to_le_bytes());
   57|    101|    h.update(&bundle.anchor().to_bytes());
   58|    101|    h.finalize()
   59|    101|}
