  323|   322k|        let r4 = (r4 << 1) | (r3 >> 63);
  324|   322k|        let r3 = (r3 << 1) | (r2 >> 63);
  325|   322k|        let r2 = (r2 << 1) | (r1 >> 63);
  326|   322k|        let r1 = r1 << 1;
