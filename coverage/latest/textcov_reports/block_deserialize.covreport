  584|  8.91M|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
  585|  8.91M|        let (d2, borrow) = sbb(self.0[2], rhs.0[2], borrow);
  586|  8.91M|        let (d3, borrow) = sbb(self.0[3], rhs.0[3], borrow);
