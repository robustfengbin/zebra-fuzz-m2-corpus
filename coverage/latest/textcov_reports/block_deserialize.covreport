  323|   335k|        let r4 = (r4 << 1) | (r3 >> 63);
  324|   335k|        let r3 = (r3 << 1) | (r2 >> 63);
  325|   335k|        let r2 = (r2 << 1) | (r1 >> 63);
  326|   335k|        let r1 = r1 << 1;
