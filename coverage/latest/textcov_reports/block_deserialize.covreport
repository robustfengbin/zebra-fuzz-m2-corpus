  155|    290|
  156|    290|            nh.write_all(&s_spend.cv().to_bytes()).unwrap();
  157|    290|            nh.write_all(&s_spend.anchor().to_repr()).unwrap();
  158|    290|            nh.write_all(&<[u8; 32]>::from(*s_spend.rk())).unwrap();
  159|    290|        }
