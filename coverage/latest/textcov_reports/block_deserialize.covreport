  704|    960|        let rd = sqr(rc, 4) * r11;
  705|    960|        let re = sqr(rd, 6) * r111;
  706|    960|        let rf = sqr(re, 3) * r111;
  707|    960|        let rg = sqr(rf, 10) * r1001;
  708|    960|        let rh = sqr(rg, 5) * r1001;
  709|    960|        let ri = sqr(rh, 4) * r1001;
  710|    960|        let rj = sqr(ri, 3) * r111;
  711|    960|        let rk = sqr(rj, 4) * r1001;
  712|    960|        let rl = sqr(rk, 5) * r11;
  713|    960|        let rm = sqr(rl, 4) * r111;
  714|    960|        let rn = sqr(rm, 4) * r11;
  715|    960|        let ro = sqr(rn, 6) * r1001;
  716|    960|        let rp = sqr(ro, 5) * r1101;
  717|    960|        let rq = sqr(rp, 4) * r11;
  718|    960|        let rr = sqr(rq, 7) * r111;
  719|    960|        let rs = sqr(rr, 3) * r11;
  720|    960|        rs.square() // rt
  721|    960|    }

