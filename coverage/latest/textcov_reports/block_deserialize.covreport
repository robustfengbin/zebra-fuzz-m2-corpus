   29|  38.1k|            let tail_ptr = data.as_ptr().add(blocks_len);
   30|  38.1k|            (
   31|  38.1k|                slice::from_raw_parts(blocks_ptr, nb),
   32|  38.1k|                slice::from_raw_parts(tail_ptr, tail_len),
   33|  38.1k|            )
