  220|    120|            ephemeral_key: x25519_dalek::PublicKey::from(reader.read_32_bytes()?),
  221|       |            // Type is `B^{[ℓ_{Seed}]}`, i.e. 32 bytes
  222|    120|            random_seed: RandomSeed::from(reader.read_32_bytes()?),
