  175|       |            // Coinbase txs have the prevout index set to `u32::MAX`.
  176|    292|            if reader.read_u32::<LittleEndian>()? != 0xffff_ffff {
  177|      0|                return Err(SerializationError::Parse("Wrong index in coinbase"));
  178|    292|            }
  179|       |
