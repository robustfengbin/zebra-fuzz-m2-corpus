  521|  9.00M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|  9.00M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|  9.00M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|  9.00M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|  9.00M|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|  9.00M|        let k = r1.wrapping_mul(INV);
  528|  9.00M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|  9.00M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|  9.00M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|  9.00M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|  9.00M|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|  9.00M|        let k = r2.wrapping_mul(INV);
  535|  9.00M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|  9.00M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  9.00M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  9.00M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|  9.00M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|  9.00M|        let k = r3.wrapping_mul(INV);
  542|  9.00M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|  9.00M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|  9.00M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|  9.00M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|  9.00M|        let (r7, _) = adc(r7, carry2, carry);
