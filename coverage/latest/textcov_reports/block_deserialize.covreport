  290|  20.4k|        res[0..8].copy_from_slice(&tmp.0[0].to_le_bytes());
  291|  20.4k|        res[8..16].copy_from_slice(&tmp.0[1].to_le_bytes());
  292|  20.4k|        res[16..24].copy_from_slice(&tmp.0[2].to_le_bytes());
  293|  20.4k|        res[24..32].copy_from_slice(&tmp.0[3].to_le_bytes());
  294|       |
  295|  20.4k|        res
  296|  20.4k|    }
