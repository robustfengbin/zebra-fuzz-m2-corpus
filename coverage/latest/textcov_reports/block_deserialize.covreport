  386|       |
  387|    284|        let mut q = (limbs[0] + 19) >> 51;
  388|    284|        q = (limbs[1] + q) >> 51;
  389|    284|        q = (limbs[2] + q) >> 51;
  390|    284|        q = (limbs[3] + q) >> 51;
  391|    284|        q = (limbs[4] + q) >> 51;
  392|       |
