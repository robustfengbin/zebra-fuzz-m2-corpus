  506|  6.52M|    const fn montgomery_reduce(
  507|  6.52M|        r0: u64,
  508|  6.52M|        r1: u64,
  509|  6.52M|        r2: u64,
  510|  6.52M|        r3: u64,
  511|  6.52M|        r4: u64,
  512|  6.52M|        r5: u64,
  513|  6.52M|        r6: u64,
  514|  6.52M|        r7: u64,
  515|  6.52M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
