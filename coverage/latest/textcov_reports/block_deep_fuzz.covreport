 1134|    153|    fn transparent_value_balance_from_outputs(
 1135|    153|        &self,
 1136|    153|        outputs: &HashMap<transparent::OutPoint, transparent::Output>,
 1137|    153|    ) -> Result<ValueBalance<NegativeAllowed>, ValueBalanceError> {
 1138|    153|        let input_value = self
 1139|    153|            .inputs()
 1140|    153|            .iter()
 1141|    153|            .map(|i| i.value_from_outputs(outputs))
 1142|    153|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1143|    153|            .map_err(ValueBalanceError::Transparent)?
 1144|    153|            .constrain()
 1145|    153|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1146|       |
 1147|    153|        let output_value = self
 1148|    153|            .outputs()
 1149|    153|            .iter()
 1150|    153|            .map(|o| o.value())
 1151|    153|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1152|    153|            .map_err(ValueBalanceError::Transparent)?
 1153|    153|            .constrain()
 1154|    153|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1155|       |
 1156|    153|        (input_value - output_value)
 1157|    153|            .map(ValueBalance::from_transparent_amount)
 1158|    153|            .map_err(ValueBalanceError::Transparent)
 1159|    153|    }
