  840|     31|                    inputs: Vec::zcash_deserialize(&mut limited_reader)?,
  841|       |                    // Denoted as `tx_out_count` and `tx_out` in the spec.
  842|     31|                    outputs: Vec::zcash_deserialize(&mut limited_reader)?,
  843|       |                    // Denoted as `lock_time` in the spec.
  844|     31|                    lock_time: LockTime::zcash_deserialize(&mut limited_reader)?,
