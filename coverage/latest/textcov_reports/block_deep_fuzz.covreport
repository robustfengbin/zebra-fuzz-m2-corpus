  589|       |        // borrow = 0x000...000. Thus, we use it as a mask to conditionally add the modulus.
  590|  21.2M|        let (d0, carry) = adc(d0, MODULUS.0[0] & borrow, 0);
  591|  21.2M|        let (d1, carry) = adc(d1, MODULUS.0[1] & borrow, carry);
  592|  21.2M|        let (d2, carry) = adc(d2, MODULUS.0[2] & borrow, carry);
  593|  21.2M|        let (d3, _) = adc(d3, MODULUS.0[3] & borrow, carry);
  594|       |
  595|  21.2M|        Scalar([d0, d1, d2, d3])
  596|  21.2M|    }
