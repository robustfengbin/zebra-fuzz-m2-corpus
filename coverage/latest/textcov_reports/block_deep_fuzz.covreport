   29|   966k|            let tail_ptr = data.as_ptr().add(blocks_len);
   30|   966k|            (
   31|   966k|                slice::from_raw_parts(blocks_ptr, nb),
   32|   966k|                slice::from_raw_parts(tail_ptr, tail_len),
   33|   966k|            )
