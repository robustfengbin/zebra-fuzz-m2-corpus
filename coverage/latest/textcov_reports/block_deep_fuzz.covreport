  177|  6.14k|pub(crate) fn hash_sapling_outputs<A>(shielded_outputs: &[OutputDescription<A>]) -> Blake2bHash {
  178|  6.14k|    let mut h = hasher(ZCASH_SAPLING_OUTPUTS_HASH_PERSONALIZATION);
  179|  6.14k|    if !shielded_outputs.is_empty() {
  180|  4.64k|        let mut ch = hasher(ZCASH_SAPLING_OUTPUTS_COMPACT_HASH_PERSONALIZATION);
  181|  4.64k|        let mut mh = hasher(ZCASH_SAPLING_OUTPUTS_MEMOS_HASH_PERSONALIZATION);
  182|  4.64k|        let mut nh = hasher(ZCASH_SAPLING_OUTPUTS_NONCOMPACT_HASH_PERSONALIZATION);
  183|  10.8k|        for s_out in shielded_outputs {
  184|  6.18k|            ch.write_all(s_out.cmu().to_bytes().as_ref()).unwrap();
  185|  6.18k|            ch.write_all(s_out.ephemeral_key().as_ref()).unwrap();
