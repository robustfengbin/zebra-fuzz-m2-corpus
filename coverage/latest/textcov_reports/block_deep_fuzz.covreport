  556|       |
  557|  11.0M|        let (r0, carry) = mac(0, self.0[0], rhs.0[0], 0);
  558|  11.0M|        let (r1, carry) = mac(0, self.0[0], rhs.0[1], carry);
  559|  11.0M|        let (r2, carry) = mac(0, self.0[0], rhs.0[2], carry);
  560|  11.0M|        let (r3, r4) = mac(0, self.0[0], rhs.0[3], carry);
  561|       |
  562|  11.0M|        let (r1, carry) = mac(r1, self.0[1], rhs.0[0], 0);
  563|  11.0M|        let (r2, carry) = mac(r2, self.0[1], rhs.0[1], carry);
  564|  11.0M|        let (r3, carry) = mac(r3, self.0[1], rhs.0[2], carry);
  565|  11.0M|        let (r4, r5) = mac(r4, self.0[1], rhs.0[3], carry);
  566|       |
  567|  11.0M|        let (r2, carry) = mac(r2, self.0[2], rhs.0[0], 0);
  568|  11.0M|        let (r3, carry) = mac(r3, self.0[2], rhs.0[1], carry);
  569|  11.0M|        let (r4, carry) = mac(r4, self.0[2], rhs.0[2], carry);
  570|  11.0M|        let (r5, r6) = mac(r5, self.0[2], rhs.0[3], carry);
  571|       |
  572|  11.0M|        let (r3, carry) = mac(r3, self.0[3], rhs.0[0], 0);
  573|  11.0M|        let (r4, carry) = mac(r4, self.0[3], rhs.0[1], carry);
  574|  11.0M|        let (r5, carry) = mac(r5, self.0[3], rhs.0[2], carry);
