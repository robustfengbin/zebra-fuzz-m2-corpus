  156|    664|        writer.write_32_bytes(&(&self.random_seed).into())?;
  157|       |
  158|    664|        self.vmacs[0].zcash_serialize(&mut writer)?;
  159|    664|        self.vmacs[1].zcash_serialize(&mut writer)?;
  160|    664|        self.zkproof.zcash_serialize(&mut writer)?;
  161|       |
  162|    664|        self.enc_ciphertexts[0].zcash_serialize(&mut writer)?;
  163|    664|        self.enc_ciphertexts[1].zcash_serialize(&mut writer)?;
  164|       |
  165|    664|        Ok(())
  166|    664|    }
