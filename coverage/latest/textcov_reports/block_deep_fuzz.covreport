  446|  4.01k|            .inputs()
  447|  4.01k|            .iter()
  448|  4.01k|            .map(transparent::Input::sequence)
  449|  4.01k|            .any(|sequence_number| sequence_number != u32::MAX);
  450|       |
  451|  4.01k|        if has_sequence_number_enabling_lock_time {
  452|  2.71k|            Some(lock_time)
  453|       |        } else {
  454|  1.30k|            None
  455|       |        }
  456|  50.6k|    }

