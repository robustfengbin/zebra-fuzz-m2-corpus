  451|  21.3k|pub fn block_subsidy(height: Height, net: &Network) -> Result<Amount<NonNegative>, SubsidyError> {
  452|  21.3k|    let Some(halving_div) = halving_divisor(height, net) else {
  453|      6|        return Ok(Amount::zero());
