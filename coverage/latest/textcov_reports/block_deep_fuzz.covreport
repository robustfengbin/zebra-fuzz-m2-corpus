  214|       |            commitments: [
  215|    233|                commitment::NoteCommitment::from(reader.read_32_bytes()?),
  216|    233|                commitment::NoteCommitment::from(reader.read_32_bytes()?),
  217|       |            ],
  218|       |            // Type is `KA^{Sprout}.Public`, i.e. `B^Y^{[32]}`, i.e. 32 bytes.
  219|       |            // https://zips.z.cash/protocol/protocol.pdf#concretesproutkeyagreement
  220|    233|            ephemeral_key: x25519_dalek::PublicKey::from(reader.read_32_bytes()?),
  221|       |            // Type is `B^{[ℓ_{Seed}]}`, i.e. 32 bytes
  222|    233|            random_seed: RandomSeed::from(reader.read_32_bytes()?),
  223|       |            // Types are `B^{ℓ^{Sprout}_{PRF}}` i.e. 32 bytes.
  224|       |            // See [`note::Mac::zcash_deserialize`].
  225|       |            vmacs: [
  226|    233|                note::Mac::zcash_deserialize(&mut reader)?,
  227|    233|                note::Mac::zcash_deserialize(&mut reader)?,
