  496|      0|            "mantissa {mantissa:x?} must fit in its compact field"
  497|       |        );
  498|  6.30k|        let mantissa = u32::try_from(mantissa).expect("a 0-23 bit value fits in a u32");
  499|       |
  500|  6.30k|        if mantissa > 0 {
  501|  6.30k|            CompactDifficulty(mantissa + (size << 24))
