  595|  29.6k|        tmp.0[1] = u64::from_le_bytes(repr[8..16].try_into().unwrap());
  596|  29.6k|        tmp.0[2] = u64::from_le_bytes(repr[16..24].try_into().unwrap());
  597|  29.6k|        tmp.0[3] = u64::from_le_bytes(repr[24..32].try_into().unwrap());
  598|       |
