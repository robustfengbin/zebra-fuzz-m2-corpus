_RNvMs_NtCsc4HhLwrPL7g_11zebra_chain11transactionNtB4_11Transaction38transparent_value_balance_from_outputs:
 1134|    220|    fn transparent_value_balance_from_outputs(
 1135|    220|        &self,
 1136|    220|        outputs: &HashMap<transparent::OutPoint, transparent::Output>,
 1137|    220|    ) -> Result<ValueBalance<NegativeAllowed>, ValueBalanceError> {
 1138|    220|        let input_value = self
 1139|    220|            .inputs()
 1140|    220|            .iter()
 1141|    220|            .map(|i| i.value_from_outputs(outputs))
 1142|    220|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1143|    220|            .map_err(ValueBalanceError::Transparent)?
 1144|    220|            .constrain()
 1145|    220|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1146|       |
 1147|    220|        let output_value = self
 1148|    220|            .outputs()
 1149|    220|            .iter()
 1150|    220|            .map(|o| o.value())
 1151|    220|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1152|    220|            .map_err(ValueBalanceError::Transparent)?
 1153|    219|            .constrain()
 1154|    219|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1155|       |
 1156|    219|        (input_value - output_value)
 1157|    219|            .map(ValueBalance::from_transparent_amount)
 1158|    219|            .map_err(ValueBalanceError::Transparent)
 1159|    220|    }
