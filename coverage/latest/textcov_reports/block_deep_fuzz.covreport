  503|       |            // This check catches invalid mantissas. Overflows and underflows
  504|       |            // should also be unreachable, but they aren't caught here.
  505|      0|            unreachable!("converted CompactDifficulty values must be valid")
  506|       |        }
  507|  6.30k|    }
