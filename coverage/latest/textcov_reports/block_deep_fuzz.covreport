  341|  44.0M|    pub const fn square(&self) -> Scalar {
  342|  44.0M|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  44.0M|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
