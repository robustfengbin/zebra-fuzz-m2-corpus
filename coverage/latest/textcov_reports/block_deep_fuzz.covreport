 1134|    172|    fn transparent_value_balance_from_outputs(
 1135|    172|        &self,
 1136|    172|        outputs: &HashMap<transparent::OutPoint, transparent::Output>,
 1137|    172|    ) -> Result<ValueBalance<NegativeAllowed>, ValueBalanceError> {
 1138|    172|        let input_value = self
 1139|    172|            .inputs()
 1140|    172|            .iter()
