  395|  21.3k|pub(crate) fn to_hash(
  396|  21.3k|    _txversion: TxVersion,
  397|  21.3k|    consensus_branch_id: BranchId,
  398|  21.3k|    header_digest: Blake2bHash,
  399|  21.3k|    transparent_digest: Blake2bHash,
  400|  21.3k|    sapling_digest: Option<Blake2bHash>,
  401|  21.3k|    orchard_digest: Option<Blake2bHash>,
  402|  21.3k|    #[cfg(zcash_unstable = "zfuture")] tze_digests: Option<&TzeDigests<Blake2bHash>>,
  403|  21.3k|) -> Blake2bHash {
  404|  21.3k|    let mut personal = [0; 16];
  405|  21.3k|    personal[..12].copy_from_slice(ZCASH_TX_PERSONALIZATION_PREFIX);
  406|  21.3k|    (&mut personal[12..])
  407|  21.3k|        .write_u32_le(consensus_branch_id.into())
