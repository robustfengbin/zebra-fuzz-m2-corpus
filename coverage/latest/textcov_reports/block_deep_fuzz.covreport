  859|       |                type OptV3Jsd = Option<JoinSplitData<Bctv14Proof>>;
  860|       |                Ok(Transaction::V3 {
  861|       |                    // Denoted as `tx_in_count` and `tx_in` in the spec.
  862|    632|                    inputs: Vec::zcash_deserialize(&mut limited_reader)?,
  863|       |                    // Denoted as `tx_out_count` and `tx_out` in the spec.
  864|    632|                    outputs: Vec::zcash_deserialize(&mut limited_reader)?,
  865|       |                    // Denoted as `lock_time` in the spec.
  866|    632|                    lock_time: LockTime::zcash_deserialize(&mut limited_reader)?,
  867|       |                    // Denoted as `nExpiryHeight` in the spec.
  868|    632|                    expiry_height: block::Height(limited_reader.read_u32::<LittleEndian>()?),
  869|       |                    // A bundle of fields denoted in the spec as `nJoinSplit`, `vJoinSplit`,
  870|       |                    // `joinSplitPubKey` and `joinSplitSig`.
  871|    632|                    joinsplit_data: OptV3Jsd::zcash_deserialize(&mut limited_reader)?,
  872|       |                })
  873|       |            }
  874|       |            (4, true) => {
  875|       |                // Transaction V4 spec:
  876|       |                // https://zips.z.cash/protocol/protocol.pdf#txnencoding
  877|       |
  878|       |                // Denoted as `nVersionGroupId` in the spec.
  879|  3.77k|                let id = limited_reader.read_u32::<LittleEndian>()?;
  880|  3.77k|                if id != SAPLING_VERSION_GROUP_ID {
  881|      0|                    return Err(SerializationError::Parse(
  882|      0|                        "expected SAPLING_VERSION_GROUP_ID",
  883|      0|                    ));
