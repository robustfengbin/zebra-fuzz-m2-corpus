  591|  20.6M|        let (d1, carry) = adc(d1, MODULUS.0[1] & borrow, carry);
  592|  20.6M|        let (d2, carry) = adc(d2, MODULUS.0[2] & borrow, carry);
  593|  20.6M|        let (d3, _) = adc(d3, MODULUS.0[3] & borrow, carry);
  594|       |
  595|  20.6M|        Scalar([d0, d1, d2, d3])
  596|  20.6M|    }
