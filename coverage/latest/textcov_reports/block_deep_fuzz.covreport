  830|       |                // Denoted as `tx_out_count` and `tx_out` in the spec.
  831|    139|                outputs: Vec::zcash_deserialize(&mut limited_reader)?,
  832|       |                // Denoted as `lock_time` in the spec.
  833|    139|                lock_time: LockTime::zcash_deserialize(&mut limited_reader)?,
  834|       |            }),
  835|       |            (2, false) => {
