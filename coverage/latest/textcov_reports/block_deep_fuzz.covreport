  353|  41.1M|        let r5 = (r5 << 1) | (r4 >> 63);
  354|  41.1M|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  41.1M|        let r3 = (r3 << 1) | (r2 >> 63);
  356|  41.1M|        let r2 = (r2 << 1) | (r1 >> 63);
  357|  41.1M|        let r1 = r1 << 1;
