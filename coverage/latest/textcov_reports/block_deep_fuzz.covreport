  418|  22.8M|    pub const fn sub(&self, rhs: &Self) -> Self {
  419|  22.8M|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  420|  22.8M|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
