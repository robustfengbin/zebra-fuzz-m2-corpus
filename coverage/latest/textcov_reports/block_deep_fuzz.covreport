  600|  5.39M|    pub const fn add(&self, rhs: &Self) -> Self {
  601|  5.39M|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  602|  5.39M|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
  603|  5.39M|        let (d2, carry) = adc(self.0[2], rhs.0[2], carry);
  604|  5.39M|        let (d3, _) = adc(self.0[3], rhs.0[3], carry);
