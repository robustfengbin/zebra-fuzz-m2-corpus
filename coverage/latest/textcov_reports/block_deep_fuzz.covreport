  161|    882|    fn zcash_serialize<W: io::Write>(&self, mut writer: W) -> Result<(), io::Error> {
  162|    882|        writer.write_all(&self.cv.0.to_bytes())?;
  163|    882|        self.per_spend_anchor.zcash_serialize(&mut writer)?;
  164|    882|        writer.write_32_bytes(&self.nullifier.into())?;
  165|    882|        writer.write_all(&<[u8; 32]>::from(self.rk.clone())[..])?;
  166|    882|        self.zkproof.zcash_serialize(&mut writer)?;
  167|    882|        writer.write_all(&<[u8; 64]>::from(self.spend_auth_sig)[..])?;
