  471|       |        } else {
  472|  10.4k|            MAX_BLOCK_SUBSIDY / u64::from(BLOSSOM_POW_TARGET_SPACING_RATIO)
  473|       |        };
  474|       |
  475|  15.5k|        base_subsidy / halving_div
  476|       |    };
  477|       |
  478|  21.3k|    Ok(Amount::try_from(amount)?)
  479|  21.3k|}
