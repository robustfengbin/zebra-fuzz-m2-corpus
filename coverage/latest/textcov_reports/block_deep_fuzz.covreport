 1134|    196|    fn transparent_value_balance_from_outputs(
 1135|    196|        &self,
 1136|    196|        outputs: &HashMap<transparent::OutPoint, transparent::Output>,
 1137|    196|    ) -> Result<ValueBalance<NegativeAllowed>, ValueBalanceError> {
 1138|    196|        let input_value = self
 1139|    196|            .inputs()
 1140|    196|            .iter()
 1141|    196|            .map(|i| i.value_from_outputs(outputs))
 1142|    196|            .sum::<Result<Amount<NonNegative>, AmountError>>()
