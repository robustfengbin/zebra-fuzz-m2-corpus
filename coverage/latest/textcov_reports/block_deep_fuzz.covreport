  544|  31.1k|    const fn montgomery_reduce(
  545|  31.1k|        r0: u64,
  546|  31.1k|        r1: u64,
  547|  31.1k|        r2: u64,
  548|  31.1k|        r3: u64,
  549|  31.1k|        r4: u64,
  550|  31.1k|        r5: u64,
  551|  31.1k|        r6: u64,
  552|  31.1k|        r7: u64,
  553|  31.1k|    ) -> Self {
  554|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  555|       |        // Handbook of Applied Cryptography
  556|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  557|       |
  558|  31.1k|        let k = r0.wrapping_mul(INV);
  559|  31.1k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  560|  31.1k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  561|  31.1k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  562|  31.1k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  563|  31.1k|        let (r4, carry2) = adc(r4, 0, carry);
  564|       |
  565|  31.1k|        let k = r1.wrapping_mul(INV);
  566|  31.1k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  567|  31.1k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  568|  31.1k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  569|  31.1k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  570|  31.1k|        let (r5, carry2) = adc(r5, carry2, carry);
  571|       |
  572|  31.1k|        let k = r2.wrapping_mul(INV);
  573|  31.1k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  574|  31.1k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  575|  31.1k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  576|  31.1k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  577|  31.1k|        let (r6, carry2) = adc(r6, carry2, carry);
  578|       |
  579|  31.1k|        let k = r3.wrapping_mul(INV);
  580|  31.1k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  581|  31.1k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  582|  31.1k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  583|  31.1k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  584|  31.1k|        let (r7, _) = adc(r7, carry2, carry);
  585|       |
  586|       |        // Result may be within MODULUS of the correct value
  587|  31.1k|        (&Fr([r4, r5, r6, r7])).sub(&MODULUS)
  588|  31.1k|    }
