  161|  4.05k|        let compact_digest = ch.finalize();
  162|  4.05k|        h.write_all(compact_digest.as_bytes()).unwrap();
  163|  4.05k|        let noncompact_digest = nh.finalize();
  164|  4.05k|        h.write_all(noncompact_digest.as_bytes()).unwrap();
  165|  2.09k|    }
  166|  6.14k|    h.finalize()
