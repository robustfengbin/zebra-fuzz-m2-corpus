   21|  1.14M|    fn split_blocks<N: ArrayLength<u8>>(data: &[u8]) -> (&[Block<N>], &[u8]) {
   22|  1.14M|        let nb = data.len() / N::USIZE;
   23|  1.14M|        let blocks_len = nb * N::USIZE;
   24|  1.14M|        let tail_len = data.len() - blocks_len;
   25|       |        // SAFETY: we guarantee that created slices do not point
   26|       |        // outside of `data`
   27|       |        unsafe {
   28|  1.14M|            let blocks_ptr = data.as_ptr() as *const Block<N>;
   29|  1.14M|            let tail_ptr = data.as_ptr().add(blocks_len);
   30|  1.14M|            (
   31|  1.14M|                slice::from_raw_parts(blocks_ptr, nb),
   32|  1.14M|                slice::from_raw_parts(tail_ptr, tail_len),
   33|  1.14M|            )
   34|       |        }
   35|  1.14M|    }

