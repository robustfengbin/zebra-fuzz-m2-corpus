  143|  1.03k|    fn zcash_serialize<W: io::Write>(&self, mut writer: W) -> Result<(), io::Error> {
  144|  1.03k|        self.vpub_old.zcash_serialize(&mut writer)?;
  145|  1.03k|        self.vpub_new.zcash_serialize(&mut writer)?;
  146|       |
  147|  1.03k|        writer.write_32_bytes(&self.anchor.into())?;
  148|  1.03k|        writer.write_32_bytes(&self.nullifiers[0].into())?;
  149|  1.03k|        writer.write_32_bytes(&self.nullifiers[1].into())?;
  150|  1.03k|        writer.write_32_bytes(&self.commitments[0].into())?;
  151|  1.03k|        writer.write_32_bytes(&self.commitments[1].into())?;
  152|       |
  153|  1.03k|        writer.write_all(&self.ephemeral_key.as_bytes()[..])?;
  154|       |        // The borrow is actually needed to avoid taking ownership
