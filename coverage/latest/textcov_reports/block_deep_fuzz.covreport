  156|  1.03k|        writer.write_32_bytes(&(&self.random_seed).into())?;
  157|       |
  158|  1.03k|        self.vmacs[0].zcash_serialize(&mut writer)?;
  159|  1.03k|        self.vmacs[1].zcash_serialize(&mut writer)?;
  160|  1.03k|        self.zkproof.zcash_serialize(&mut writer)?;
  161|       |
  162|  1.03k|        self.enc_ciphertexts[0].zcash_serialize(&mut writer)?;
  163|  1.03k|        self.enc_ciphertexts[1].zcash_serialize(&mut writer)?;
  164|       |
  165|  1.03k|        Ok(())
  166|  1.03k|    }
