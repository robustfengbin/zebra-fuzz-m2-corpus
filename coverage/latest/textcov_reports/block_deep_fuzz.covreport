  692|  20.4k|    fn pow_by_t_minus1_over2(&self) -> Self {
  693|  20.4k|        let sqr = |x: Fp, i: u32| (0..i).fold(x, |x, _| x.square());
  694|       |
  695|  20.4k|        let r10 = self.square();
  696|  20.4k|        let r11 = r10 * self;
  697|  20.4k|        let r110 = r11.square();
  698|  20.4k|        let r111 = r110 * self;
  699|  20.4k|        let r1001 = r111 * r10;
  700|  20.4k|        let r1101 = r111 * r110;
  701|  20.4k|        let ra = sqr(*self, 129) * self;
  702|  20.4k|        let rb = sqr(ra, 7) * r1001;
  703|  20.4k|        let rc = sqr(rb, 7) * r1101;
  704|  20.4k|        let rd = sqr(rc, 4) * r11;
  705|  20.4k|        let re = sqr(rd, 6) * r111;
  706|  20.4k|        let rf = sqr(re, 3) * r111;
  707|  20.4k|        let rg = sqr(rf, 10) * r1001;
  708|  20.4k|        let rh = sqr(rg, 5) * r1001;
  709|  20.4k|        let ri = sqr(rh, 4) * r1001;
  710|  20.4k|        let rj = sqr(ri, 3) * r111;
  711|  20.4k|        let rk = sqr(rj, 4) * r1001;
  712|  20.4k|        let rl = sqr(rk, 5) * r11;
  713|  20.4k|        let rm = sqr(rl, 4) * r111;
  714|  20.4k|        let rn = sqr(rm, 4) * r11;
  715|  20.4k|        let ro = sqr(rn, 6) * r1001;
  716|  20.4k|        let rp = sqr(ro, 5) * r1101;
  717|  20.4k|        let rq = sqr(rp, 4) * r11;
  718|  20.4k|        let rr = sqr(rq, 7) * r111;
  719|  20.4k|        let rs = sqr(rr, 3) * r11;
  720|  20.4k|        rs.square() // rt
  721|  20.4k|    }
