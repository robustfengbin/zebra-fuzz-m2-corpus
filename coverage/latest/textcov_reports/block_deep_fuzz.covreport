  427|  22.8M|        let (d1, carry) = adc(d1, MODULUS.0[1] & borrow, carry);
  428|  22.8M|        let (d2, carry) = adc(d2, MODULUS.0[2] & borrow, carry);
  429|  22.8M|        let (d3, _) = adc(d3, MODULUS.0[3] & borrow, carry);
