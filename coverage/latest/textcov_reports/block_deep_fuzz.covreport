  139|  5.81k|    let ta = z_u2.square() + z_u2;
  140|  5.81k|    let num_x1 = b * (ta + F::ONE);
  141|  5.81k|    let div = a * F::conditional_select(&-ta, &z, ta.is_zero());
  142|  5.81k|    let num2_x1 = num_x1.square();
  143|  5.81k|    let div2 = div.square();
  144|  5.81k|    let div3 = div2 * div;
  145|  5.81k|    let num_gx1 = (num2_x1 + a * div2) * num_x1 + b * div3;
