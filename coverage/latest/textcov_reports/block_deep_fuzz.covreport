  707|  21.7k|        let rg = sqr(rf, 10) * r1001;
  708|  21.7k|        let rh = sqr(rg, 5) * r1001;
  709|  21.7k|        let ri = sqr(rh, 4) * r1001;
  710|  21.7k|        let rj = sqr(ri, 3) * r111;
  711|  21.7k|        let rk = sqr(rj, 4) * r1001;
  712|  21.7k|        let rl = sqr(rk, 5) * r11;
  713|  21.7k|        let rm = sqr(rl, 4) * r111;
  714|  21.7k|        let rn = sqr(rm, 4) * r11;
  715|  21.7k|        let ro = sqr(rn, 6) * r1001;
  716|  21.7k|        let rp = sqr(ro, 5) * r1101;
  717|  21.7k|        let rq = sqr(rp, 4) * r11;
  718|  21.7k|        let rr = sqr(rq, 7) * r111;
