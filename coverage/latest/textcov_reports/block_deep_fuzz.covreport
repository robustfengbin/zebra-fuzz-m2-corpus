_RNvMs_NtCsc4HhLwrPL7g_11zebra_chain11transactionNtB4_11Transaction38transparent_value_balance_from_outputs:
 1134|    194|    fn transparent_value_balance_from_outputs(
 1135|    194|        &self,
 1136|    194|        outputs: &HashMap<transparent::OutPoint, transparent::Output>,
 1137|    194|    ) -> Result<ValueBalance<NegativeAllowed>, ValueBalanceError> {
 1138|    194|        let input_value = self
 1139|    194|            .inputs()
 1140|    194|            .iter()
 1141|    194|            .map(|i| i.value_from_outputs(outputs))
 1142|    194|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1143|    194|            .map_err(ValueBalanceError::Transparent)?
 1144|    194|            .constrain()
 1145|    194|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1146|       |
 1147|    194|        let output_value = self
 1148|    194|            .outputs()
 1149|    194|            .iter()
 1150|    194|            .map(|o| o.value())
 1151|    194|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1152|    194|            .map_err(ValueBalanceError::Transparent)?
 1153|    194|            .constrain()
 1154|    194|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1155|       |
 1156|    194|        (input_value - output_value)
 1157|    194|            .map(ValueBalance::from_transparent_amount)
 1158|    194|            .map_err(ValueBalanceError::Transparent)
 1159|    194|    }
