  582|  20.6M|    pub const fn sub(&self, rhs: &Self) -> Self {
  583|  20.6M|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  584|  20.6M|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
  585|  20.6M|        let (d2, borrow) = sbb(self.0[2], rhs.0[2], borrow);
  586|  20.6M|        let (d3, borrow) = sbb(self.0[3], rhs.0[3], borrow);
