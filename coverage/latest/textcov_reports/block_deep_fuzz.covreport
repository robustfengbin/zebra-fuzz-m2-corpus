  494|  5.11k|        assert!(
  495|  5.11k|            mantissa <= UNSIGNED_MANTISSA_MASK.into(),
  496|      0|            "mantissa {mantissa:x?} must fit in its compact field"
  497|       |        );
  498|  5.11k|        let mantissa = u32::try_from(mantissa).expect("a 0-23 bit value fits in a u32");
