 1145|    172|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1146|       |
 1147|    172|        let output_value = self
 1148|    172|            .outputs()
 1149|    172|            .iter()
 1150|    172|            .map(|o| o.value())
 1151|    172|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1152|    172|            .map_err(ValueBalanceError::Transparent)?
 1153|    172|            .constrain()
 1154|    172|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1155|       |
 1156|    172|        (input_value - output_value)
 1157|    172|            .map(ValueBalance::from_transparent_amount)
 1158|    172|            .map_err(ValueBalanceError::Transparent)
 1159|    172|    }
