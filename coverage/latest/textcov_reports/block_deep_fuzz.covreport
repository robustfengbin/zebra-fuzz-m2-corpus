   39|  1.47k|pub fn coinbase_is_first(block: &Block) -> Result<Arc<transaction::Transaction>, BlockError> {
   40|       |    // # Consensus
   41|       |    //
   42|       |    // > A block MUST have at least one transaction
   43|       |    //
   44|       |    // <https://zips.z.cash/protocol/protocol.pdf#blockheader>
