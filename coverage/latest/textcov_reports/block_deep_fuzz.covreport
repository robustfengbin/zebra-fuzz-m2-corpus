_RNvMs_NtCsc4HhLwrPL7g_11zebra_chain11transactionNtB4_11Transaction38transparent_value_balance_from_outputs:
 1134|    333|    fn transparent_value_balance_from_outputs(
 1135|    333|        &self,
 1136|    333|        outputs: &HashMap<transparent::OutPoint, transparent::Output>,
 1137|    333|    ) -> Result<ValueBalance<NegativeAllowed>, ValueBalanceError> {
 1138|    333|        let input_value = self
 1139|    333|            .inputs()
 1140|    333|            .iter()
 1141|    333|            .map(|i| i.value_from_outputs(outputs))
 1142|    333|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1143|    333|            .map_err(ValueBalanceError::Transparent)?
 1144|    333|            .constrain()
 1145|    333|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1146|       |
 1147|    333|        let output_value = self
 1148|    333|            .outputs()
 1149|    333|            .iter()
 1150|    333|            .map(|o| o.value())
 1151|    333|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1152|    333|            .map_err(ValueBalanceError::Transparent)?
 1153|    333|            .constrain()
 1154|    333|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1155|       |
 1156|    333|        (input_value - output_value)
 1157|    333|            .map(ValueBalance::from_transparent_amount)
 1158|    333|            .map_err(ValueBalanceError::Transparent)
 1159|    333|    }
