  409|       |
  410|  21.3k|    let mut h = hasher(&personal);
  411|  21.3k|    h.write_all(header_digest.as_bytes()).unwrap();
  412|  21.3k|    h.write_all(transparent_digest.as_bytes()).unwrap();
  413|  21.3k|    h.write_all(
  414|  21.3k|        sapling_digest
  415|  21.3k|            .unwrap_or_else(hash_sapling_txid_empty)
  416|  21.3k|            .as_bytes(),
  417|       |    )
  418|  21.3k|    .unwrap();
  419|  21.3k|    h.write_all(
  420|  21.3k|        orchard_digest
  421|  21.3k|            .unwrap_or_else(orchard::commitments::hash_bundle_txid_empty)
  422|  21.3k|            .as_bytes(),
  423|       |    )
  424|  21.3k|    .unwrap();
  425|       |
  426|       |    #[cfg(zcash_unstable = "zfuture")]
  427|       |    if _txversion.has_tze() {
  428|       |        h.write_all(hash_tze_txid_data(tze_digests).as_bytes())
  429|       |            .unwrap();
  430|       |    }
  431|       |
  432|  21.3k|    h.finalize()
  433|  21.3k|}
