 1144|    196|            .constrain()
 1145|    196|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1146|       |
 1147|    196|        let output_value = self
 1148|    196|            .outputs()
 1149|    196|            .iter()
 1150|    196|            .map(|o| o.value())
 1151|    196|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1152|    196|            .map_err(ValueBalanceError::Transparent)?
 1153|    196|            .constrain()
 1154|    196|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1155|       |
 1156|    196|        (input_value - output_value)
 1157|    196|            .map(ValueBalance::from_transparent_amount)
 1158|    196|            .map_err(ValueBalanceError::Transparent)
 1159|    196|    }
