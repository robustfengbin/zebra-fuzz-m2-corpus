  187|  6.18k|
  188|  6.18k|            mh.write_all(&s_out.enc_ciphertext()[52..564]).unwrap();
  189|  6.18k|
  190|  6.18k|            nh.write_all(&s_out.cv().to_bytes()).unwrap();
  191|  6.18k|            nh.write_all(&s_out.enc_ciphertext()[564..]).unwrap();
  192|  6.18k|            nh.write_all(&s_out.out_ciphertext()[..]).unwrap();
  193|  6.18k|        }
  194|       |
  195|  4.64k|        h.write_all(ch.finalize().as_bytes()).unwrap();
  196|  4.64k|        h.write_all(mh.finalize().as_bytes()).unwrap();
  197|  4.64k|        h.write_all(nh.finalize().as_bytes()).unwrap();
  198|  1.49k|    }
  199|  6.14k|    h.finalize()
  200|  6.14k|}
