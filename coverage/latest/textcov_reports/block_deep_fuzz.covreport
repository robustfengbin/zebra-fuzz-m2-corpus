  829|    165|                inputs: Vec::zcash_deserialize(&mut limited_reader)?,
  830|       |                // Denoted as `tx_out_count` and `tx_out` in the spec.
  831|    165|                outputs: Vec::zcash_deserialize(&mut limited_reader)?,
  832|       |                // Denoted as `lock_time` in the spec.
  833|    165|                lock_time: LockTime::zcash_deserialize(&mut limited_reader)?,
  834|       |            }),
  835|       |            (2, false) => {
