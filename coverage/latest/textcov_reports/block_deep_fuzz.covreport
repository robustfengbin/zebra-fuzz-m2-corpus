  225|  21.3k|fn hash_header_txid_data(
  226|  21.3k|    version: TxVersion,
  227|  21.3k|    // we commit to the consensus branch ID with the header
  228|  21.3k|    consensus_branch_id: BranchId,
  229|  21.3k|    lock_time: u32,
  230|  21.3k|    expiry_height: BlockHeight,
  231|  21.3k|    #[cfg(all(
  232|  21.3k|        any(zcash_unstable = "nu7", zcash_unstable = "zfuture"),
  233|  21.3k|        feature = "zip-233"
  234|  21.3k|    ))]
  235|  21.3k|    zip233_amount: &Zatoshis,
  236|  21.3k|) -> Blake2bHash {
  237|  21.3k|    let mut h = hasher(ZCASH_HEADERS_HASH_PERSONALIZATION);
  238|       |
  239|  21.3k|    h.write_u32_le(version.header()).unwrap();
  240|  21.3k|    h.write_u32_le(version.version_group_id()).unwrap();
  241|  21.3k|    h.write_u32_le(consensus_branch_id.into()).unwrap();
  242|  21.3k|    h.write_u32_le(lock_time).unwrap();
  243|  21.3k|    h.write_u32_le(expiry_height.into()).unwrap();
  244|       |
  245|       |    // TODO: Factor this out into a separate txid computation when implementing ZIP 246 in full.
  246|       |    #[cfg(all(
  247|       |        any(zcash_unstable = "nu7", zcash_unstable = "zfuture"),
  248|       |        feature = "zip-233"
  249|       |    ))]
  250|       |    if version.has_zip233() {
  251|       |        h.write_u64_le((*zip233_amount).into()).unwrap();
  252|       |    }
  253|       |
  254|  21.3k|    h.finalize()
  255|  21.3k|}
